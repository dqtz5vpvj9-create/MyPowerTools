{
  "schemaVersion": "1.0",
  "id": "sample.dotnet-inproc",
  "packageId": "sample-dotnet-inproc",
  "displayName": "Sample .NET InProc Module",
  "version": "0.2.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "inproc-dotnet",
      "priority": 90,
      "assembly": "bin/Release/net10.0/Sample.DotNetInProc.MyPowerTools.dll",
      "type": "Sample.DotNetInProc.ModuleEntry"
    }
  ],
  "runtimePolicy": {
    "preferred": "inproc",
    "allowInProc": true,
    "inProcRules": {
      "maxCallMs": 3000,
      "allowNativeDll": false,
      "allowWindow": false,
      "allowBackgroundThreads": false,
      "loadContext": "collectible",
      "shadowCopy": true,
      "sharedAssemblies": [
        "MyPowerTools.Abstractions",
        "Microsoft.Extensions.Logging.Abstractions",
        "Microsoft.Extensions.DependencyInjection.Abstractions"
      ]
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "sidecar-required",
      "systemMutation": "broker-required",
      "nativeHardware": "sidecar-required",
      "elevatedWrite": "broker-required",
      "externalProcess": "sidecar-required"
    }
  },
  "capabilities": [
    "status",
    "commands",
    "settings",
    "dashboardCard"
  ],
  "permissions": [],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "uiSurfaces": [
    "ui/dashboard-card.json"
  ]
}
