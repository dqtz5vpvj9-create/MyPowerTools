{
  "schemaVersion": "1.0",
  "id": "sample.stdio-compat-module",
  "packageId": "sample-stdio-compat-package",
  "displayName": "Sample stdio Compatibility Module",
  "version": "0.2.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "jsonrpc-stdio",
      "priority": 10,
      "compat": true,
      "command": "python",
      "args": [
        "module_server.py"
      ]
    }
  ],
  "runtimePolicy": {
    "preferred": "compat",
    "allowInProc": false,
    "sidecarRules": {
      "readyTimeoutMs": 8000,
      "restartLimit": 1,
      "restartWindowSeconds": 30,
      "killProcessTree": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "sidecar-required",
      "systemMutation": "broker-required",
      "nativeHardware": "sidecar-required",
      "elevatedWrite": "broker-required",
      "externalProcess": "sidecar-required"
    }
  },
  "capabilities": [
    "status",
    "commands"
  ],
  "permissions": []
  ,
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "uiSurfaces": [
    "ui/dashboard-card.json"
  ]
}
