{
  "schemaVersion": "1.0",
  "id": "sample.webview-module",
  "packageId": "sample-webview-module",
  "displayName": "Sample WebView Module",
  "version": "0.2.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "http",
      "priority": 70,
      "baseUrl": "http://127.0.0.1:42100",
      "health": {
        "path": "/api/status"
      }
    }
  ],
  "runtimePolicy": {
    "preferred": "service",
    "allowInProc": false,
    "sidecarRules": {
      "readyTimeoutMs": 8000,
      "restartLimit": 0,
      "restartWindowSeconds": 30,
      "killProcessTree": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "sidecar-required",
      "systemMutation": "broker-required",
      "nativeHardware": "sidecar-required",
      "elevatedWrite": "broker-required",
      "externalProcess": "sidecar-required"
    }
  },
  "capabilities": [
    "status",
    "commands",
    "dashboardCard",
    "detailPage",
    "webview"
  ],
  "permissions": [],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "uiSurfaces": [
    "ui/dashboard-card.json",
    "ui/detail-webview.json"
  ]
}
