{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mypowertools.dev/schemas/package.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "version",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "minHostVersion": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared": {
      "type": "object",
      "properties": {
        "runtimes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "entrypoints"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "entrypoints": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "assets": {
          "type": "string"
        },
        "dataDir": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "hashes": {
      "type": "string"
    },
    "trust": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "local",
            "signed"
          ]
        },
        "signature": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "format": {
              "type": "string",
              "enum": [
                "mpt-signature-v1"
              ]
            },
            "required": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
