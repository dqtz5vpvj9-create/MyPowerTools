{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mypowertools.dev/schemas/settings.schema.json",
  "type": "object",
  "required": [
    "sections"
  ],
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
