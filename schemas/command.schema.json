{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mypowertools.dev/schemas/command.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "action",
        "open",
        "toggle",
        "search",
        "form"
      ]
    },
    "category": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "requiresElevation": {
      "type": "boolean"
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operationConstraint"
      },
      "uniqueItems": true
    },
    "mutatesSystemState": {
      "type": "boolean"
    },
    "requiresElevatedWrites": {
      "type": "boolean"
    },
    "usesNativeHardware": {
      "type": "boolean"
    },
    "runsExternalProcesses": {
      "type": "boolean"
    },
    "requiresLongRunningLoop": {
      "type": "boolean"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "timeoutMs": {
      "type": "integer"
    }
  },
  "$defs": {
    "operationConstraint": {
      "type": "string",
      "enum": [
        "mutatesSystemState",
        "requiresElevatedWrites",
        "usesNativeHardware",
        "runsExternalProcesses",
        "requiresLongRunningLoop"
      ]
    }
  },
  "additionalProperties": true
}
