{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mypowertools.dev/schemas/module.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "packageId",
    "displayName",
    "version",
    "moduleSdk",
    "entrypoints",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "moduleSdk": {
      "type": "string"
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "priority"
        ],
        "properties": {
          "kind": {
            "enum": [
              "inproc-dotnet",
              "grpc-ipc",
              "package-runtime",
              "http",
              "jsonrpc-stdio"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assembly": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runtimeId": {
            "type": "string"
          },
          "service": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "windows": {
            "$ref": "#/$defs/ipcEndpoint"
          },
          "macos": {
            "$ref": "#/$defs/ipcEndpoint"
          },
          "linux": {
            "$ref": "#/$defs/ipcEndpoint"
          },
          "health": {
            "type": "object"
          },
          "compat": {
            "type": "boolean"
          },
          "startupCost": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "hotkeys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hotkey"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy shorthand. New modules should use ui.surfaces."
    },
    "staticIndexes": {
      "type": "object"
    },
    "runtimePolicy": {
      "$ref": "#/$defs/runtimePolicy",
      "description": "Runtime isolation preference and guardrails. Complex or native modules should prefer sidecar/service transports; InProc is a trusted optimized path."
    },
    "development": {
      "$ref": "#/$defs/development",
      "description": "Development-only switches. Production manifests should omit this block."
    },
    "uiSurfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths to UI surface declarations validated by ui-surface.schema.json"
    }
  },
  "$defs": {
    "runtimePolicy": {
      "type": "object",
      "required": [
        "preferred"
      ],
      "properties": {
        "preferred": {
          "type": "string",
          "enum": [
            "sidecar",
            "inproc",
            "service",
            "compat"
          ]
        },
        "allowInProc": {
          "type": "boolean",
          "default": false
        },
        "inProcRules": {
          "$ref": "#/$defs/inProcRules"
        },
        "sidecarRules": {
          "$ref": "#/$defs/sidecarRules"
        },
        "operationRules": {
          "$ref": "#/$defs/runtimeOperationRules"
        }
      },
      "additionalProperties": false
    },
    "runtimeOperationRule": {
      "type": "string",
      "enum": [
        "any",
        "inproc-or-sidecar",
        "sidecar-required",
        "service-required",
        "broker-required"
      ]
    },
    "runtimeOperationRules": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/runtimeOperationRule"
        },
        "settings": {
          "$ref": "#/$defs/runtimeOperationRule"
        },
        "commandProvider": {
          "$ref": "#/$defs/runtimeOperationRule"
        },
        "longRunningCommand": {
          "$ref": "#/$defs/runtimeOperationRule"
        },
        "systemMutation": {
          "$ref": "#/$defs/runtimeOperationRule"
        },
        "nativeHardware": {
          "$ref": "#/$defs/runtimeOperationRule"
        },
        "elevatedWrite": {
          "$ref": "#/$defs/runtimeOperationRule"
        },
        "externalProcess": {
          "$ref": "#/$defs/runtimeOperationRule"
        }
      },
      "additionalProperties": false
    },
    "inProcRules": {
      "type": "object",
      "properties": {
        "maxCallMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "allowNativeDll": {
          "type": "boolean",
          "default": false
        },
        "allowWindow": {
          "type": "boolean",
          "default": false
        },
        "allowBackgroundThreads": {
          "type": "boolean",
          "default": false
        },
        "loadContext": {
          "type": "string",
          "enum": [
            "collectible"
          ]
        },
        "shadowCopy": {
          "type": "boolean",
          "default": true
        },
        "sharedAssemblies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "sidecarRules": {
      "type": "object",
      "properties": {
        "readyTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "restartLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "restartWindowSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "killProcessTree": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "development": {
      "type": "object",
      "properties": {
        "allowAlreadyLoadedFallback": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "hotkey": {
      "type": "object",
      "required": [
        "id",
        "default",
        "commandId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "default": {
          "type": "string"
        },
        "commandId": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "default": "module"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ipcEndpoint": {
      "type": "object",
      "properties": {
        "transport": {
          "enum": [
            "named-pipe",
            "unix-domain-socket",
            "tcp"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "required": [
        "capability",
        "required"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "permission": {
      "type": "object",
      "required": [
        "id",
        "level",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "enum": [
            "user",
            "elevated",
            "service",
            "serviceUser",
            "serviceSystem",
            "sensitive",
            "broker"
          ]
        },
        "capability": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "uiSurface": {
      "type": "object",
      "required": [
        "designSystemVersion",
        "themePolicy",
        "density",
        "surfaces"
      ],
      "properties": {
        "designSystemVersion": {
          "type": "string"
        },
        "themePolicy": {
          "type": "string",
          "enum": [
            "shell-tokens-only"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "shell-controlled"
          ]
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "renderer",
              "required",
              "model"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "DashboardCard",
                  "DetailPage",
                  "SettingsSurface",
                  "CommandProvider",
                  "LogsProvider",
                  "NotificationProvider",
                  "WebViewSurface",
                  "NativeWindow"
                ]
              },
              "renderer": {
                "type": "string",
                "enum": [
                  "shell-standard",
                  "schema",
                  "component",
                  "webview-frame",
                  "native-window",
                  "custom"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "model": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "fallback": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "screenshots": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "light",
                  "dark",
                  "compact",
                  "loading",
                  "error",
                  "degraded",
                  "empty",
                  "permission",
                  "high-contrast"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "reason"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
