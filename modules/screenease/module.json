{
  "schemaVersion": "1.0",
  "id": "screenease",
  "packageId": "screenease",
  "displayName": "ScreenEase",
  "version": "0.2.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "inproc-dotnet",
      "priority": 100,
      "platforms": [
        "windows-x64",
        "windows-arm64",
        "linux-x64",
        "macos-arm64"
      ],
      "assembly": "ScreenEase.MyPowerTools.dll",
      "type": "ScreenEase.MyPowerTools.ScreenEaseModule"
    }
  ],
  "capabilities": [
    "lifecycle",
    "status",
    "commands",
    "settings",
    "logs",
    "dashboardCard",
    "detailPage"
  ],
  "runtimePolicy": {
    "preferred": "inproc",
    "allowInProc": true,
    "inProcRules": {
      "maxCallMs": 10000,
      "allowNativeDll": true,
      "allowWindow": true,
      "allowBackgroundThreads": true,
      "loadContext": "collectible",
      "shadowCopy": true
    },
    "sidecarRules": {
      "readyTimeoutMs": 8000,
      "restartLimit": 4,
      "restartWindowSeconds": 30,
      "killProcessTree": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "sidecar-required",
      "systemMutation": "broker-required",
      "nativeHardware": "inproc-or-sidecar",
      "elevatedWrite": "broker-required",
      "externalProcess": "sidecar-required"
    }
  },
  "requires": [
    {
      "capability": "display.profile",
      "required": true,
      "reason": "应用显示配置"
    },
    {
      "capability": "notification.desktop",
      "required": false,
      "reason": "显示状态通知"
    }
  ],
  "permissions": [],
  "hotkeys": [
    {
      "id": "toggle-enabled",
      "default": "Ctrl+Alt+F9",
      "commandId": "screenease.effect.toggle",
      "scope": "module",
      "reason": "Toggle the ScreenEase effect.",
      "enabledByDefault": false
    },
    {
      "id": "brightness-up",
      "default": "Ctrl+Alt+Up",
      "commandId": "screenease.effect.brightness.increase",
      "scope": "module",
      "reason": "Increase ScreenEase brightness by five percentage points.",
      "enabledByDefault": false
    },
    {
      "id": "brightness-down",
      "default": "Ctrl+Alt+Down",
      "commandId": "screenease.effect.brightness.decrease",
      "scope": "module",
      "reason": "Decrease ScreenEase brightness by five percentage points.",
      "enabledByDefault": false
    },
    {
      "id": "temperature-up",
      "default": "Ctrl+Alt+Right",
      "commandId": "screenease.effect.temperature.increase",
      "scope": "module",
      "reason": "Increase ScreenEase color temperature by 250 K.",
      "enabledByDefault": false
    },
    {
      "id": "temperature-down",
      "default": "Ctrl+Alt+Left",
      "commandId": "screenease.effect.temperature.decrease",
      "scope": "module",
      "reason": "Decrease ScreenEase color temperature by 250 K.",
      "enabledByDefault": false
    },
    {
      "id": "long-read-profile",
      "default": "Ctrl+Alt+R",
      "commandId": "screenease.profile.apply-long-read",
      "scope": "module",
      "reason": "Apply the ScreenEase long-read profile.",
      "enabledByDefault": false
    },
    {
      "id": "low-blue-evening-profile",
      "default": "Ctrl+Alt+H",
      "commandId": "screenease.profile.apply-low-blue-evening",
      "scope": "module",
      "reason": "Apply the ScreenEase low-blue evening profile.",
      "enabledByDefault": false
    },
    {
      "id": "toggle-overlay",
      "default": "Ctrl+Alt+D",
      "commandId": "screenease.overlay.toggle",
      "scope": "module",
      "reason": "Toggle the ScreenEase click-through overlay.",
      "enabledByDefault": false
    }
  ],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "tools": [
    "ui/tool.json"
  ],
  "uiSurfaces": [
    "ui/dashboard-card.json",
    "ui/detail-page.json",
    "ui/settings.json",
    "ui/logs.json"
  ]
}
