        "kind": "dotnet",
        "assembly": "surface/InputMonitor.Surface.dll",
        "type": "InputMonitor.Surface.InputMonitorSurfaceFactory"
      }
    }
  ],
  "homeCard": {
    "summary": "本机键鼠与窗口活动统计，连续工作后提醒休息。",
    "primaryActionLabel": "打开 Input Monitor",
    "statusBinding": "module.status",
    "order": 55
  },
  "shortcuts": [
