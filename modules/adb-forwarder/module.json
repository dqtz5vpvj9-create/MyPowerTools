{
  "schemaVersion": "1.0",
  "id": "adb-forwarder",
  "packageId": "adb-forwarder",
  "displayName": "AdbForwarder",
  "version": "0.2.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "inproc-dotnet",
      "priority": 100,
      "platforms": [
        "windows-x64",
        "windows-arm64",
        "linux-x64",
        "macos-arm64",
        "macos-x64"
      ],
      "assembly": "AdbForwarder.MyPowerTools.dll",
      "type": "AdbForwarder.MyPowerTools.AdbForwarderModule"
    }
  ],
  "capabilities": [
    "lifecycle",
    "status",
    "commands",
    "settings",
    "logs",
    "dashboardCard",
    "detailPage"
  ],
  "runtimePolicy": {
    "preferred": "inproc",
    "allowInProc": true,
    "inProcRules": {
      "maxCallMs": 60000,
      "allowNativeDll": false,
      "allowWindow": false,
      "allowBackgroundThreads": false,
      "loadContext": "collectible",
      "shadowCopy": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "inproc-or-sidecar",
      "systemMutation": "broker-required",
      "nativeHardware": "sidecar-required",
      "elevatedWrite": "broker-required",
      "externalProcess": "inproc-or-sidecar"
    }
  },
  "requires": [
    {
      "capability": "adb.devices",
      "required": true,
      "reason": "检测 ADB 设备"
    },
    {
      "capability": "network.portForwarding",
      "required": true,
      "reason": "管理端口转发规则"
    }
  ],
  "permissions": [
    {
      "id": "apply-portproxy",
      "level": "broker",
      "capability": "network.portForwarding",
      "reason": "写入系统端口转发规则"
    }
  ],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "tools": [
    "ui/tool.json"
  ],
  "uiSurfaces": [
    "ui/dashboard-card.json",
    "ui/detail-page.json",
    "ui/settings.json",
    "ui/logs.json"
  ]
}
