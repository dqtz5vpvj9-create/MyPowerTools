{
  "schemaVersion": "1.0",
  "id": "android-tools-suite",
  "displayName": "Android Tools Suite",
  "version": "0.2.0",
  "publisher": "lixinrui",
  "minHostVersion": "0.2.0",
  "modules": [
    "modules/notifications/module.json",
    "modules/remote-commands/module.json",
    "modules/process-monitor/module.json"
  ],
  "shared": {
    "runtimes": [
      {
        "id": "module-host",
        "entrypoints": [
          {
            "kind": "grpc-ipc",
            "priority": 100,
            "command": "windows/x64/MPTAndroidTools.Runtime.exe",
            "platforms": [
              "windows-x64"
            ],
            "windows": {
              "transport": "named-pipe",
              "name": "mypowertools.android-tools-suite.module-host"
            }
          },
          {
            "kind": "grpc-ipc",
            "priority": 100,
            "command": "linux/x64/MPTAndroidTools.Runtime",
            "platforms": [
              "linux-x64"
            ],
            "linux": {
              "transport": "unix-domain-socket",
              "path": "$XDG_RUNTIME_DIR/mypowertools/android-tools-suite/module-host.sock"
            }
          },
          {
            "kind": "grpc-ipc",
            "priority": 100,
            "command": "macos/arm64/MPTAndroidTools.Runtime",
            "platforms": [
              "macos-arm64"
            ],
            "macos": {
              "transport": "unix-domain-socket",
              "path": "$TMPDIR/mypowertools/android-tools-suite/module-host.sock"
            }
          },
          {
            "kind": "grpc-ipc",
            "priority": 100,
            "command": "macos/x64/MPTAndroidTools.Runtime",
            "platforms": [
              "macos-x64"
            ],
            "macos": {
              "transport": "unix-domain-socket",
              "path": "$TMPDIR/mypowertools/android-tools-suite/module-host.sock"
            }
          }
        ]
      }
    ],
    "assets": "shared/assets",
    "dataDir": "${MPT_PACKAGE_DATA}/android-tools-suite"
  },
  "hashes": "shared/package.hashes.json",
  "trust": {
    "policy": "local",
    "signature": {
      "path": "shared/package.signature.json",
      "format": "mpt-signature-v1",
      "required": false
    }
  }
}
