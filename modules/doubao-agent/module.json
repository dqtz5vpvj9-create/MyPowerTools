{
  "schemaVersion": "1.0",
  "id": "doubao-agent",
  "packageId": "doubao-agent",
  "displayName": "豆包 Computer Use",
  "version": "0.3.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "inproc-dotnet",
      "priority": 100,
      "assembly": "DoubaoAgent.MyPowerTools.dll",
      "type": "DoubaoAgent.MyPowerTools.DoubaoAgentModule",
      "platforms": [
        "windows",
        "linux",
        "macos"
      ]
    },
    {
      "kind": "grpc-ipc",
      "priority": 90,
      "command": "doubao-agent-controller",
      "windows": {
        "transport": "named-pipe",
        "name": "mypowertools.doubao-agent.controller"
      },
      "linux": {
        "transport": "unix-domain-socket",
        "path": "$XDG_RUNTIME_DIR/mypowertools/doubao-agent/controller.sock"
      },
      "macos": {
        "transport": "unix-domain-socket",
        "path": "$TMPDIR/mypowertools/doubao-agent/controller.sock"
      }
    },
    {
      "kind": "http",
      "priority": 30,
      "baseUrl": "http://127.0.0.1:38189",
      "health": {
        "path": "/health"
      }
    }
  ],
  "capabilities": [
    "lifecycle",
    "status",
    "commands",
    "settings",
    "logs",
    "dashboardCard",
    "detailPage"
  ],
  "runtimePolicy": {
    "preferred": "sidecar",
    "allowInProc": true,
    "inProcRules": {
      "maxCallMs": 10000,
      "allowNativeDll": false,
      "allowWindow": false,
      "allowBackgroundThreads": false,
      "loadContext": "collectible",
      "shadowCopy": true
    },
    "sidecarRules": {
      "readyTimeoutMs": 8000,
      "restartLimit": 4,
      "restartWindowSeconds": 30,
      "killProcessTree": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "sidecar-required",
      "systemMutation": "broker-required",
      "nativeHardware": "sidecar-required",
      "elevatedWrite": "broker-required",
      "externalProcess": "sidecar-required"
    }
  },
  "requires": [
    {
      "capability": "secret.store",
      "required": true,
      "reason": "读取 Agent secrets"
    },
    {
      "capability": "process.inspect",
      "required": false,
      "reason": "诊断运行时进程"
    }
  ],
  "permissions": [],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "tools": [
    "ui/tool.json"
  ],
  "uiSurfaces": [
    "ui/dashboard-card.json",
    "ui/detail-page.json",
    "ui/settings.json",
    "ui/logs.json"
  ]
}
