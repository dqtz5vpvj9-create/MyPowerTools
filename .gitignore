# .NET build outputs
bin/
obj/
[Bb]in/
[Oo]bj/

# DDNS Service Unit ships a script-only bin payload that must be tracked.
!tools/ddns/service-units/ddns.service/bin/
!tools/ddns/service-units/ddns.service/bin/*

# IDE and user-local files
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Generated release and smoke artifacts
artifacts/
**/TestResults/

# Local runtime state
logs/
state/
*.log
*.jsonl

# Packages and archives generated locally
*.nupkg
*.snupkg
*.zip

# Python caches
__pycache__/
*.py[cod]

# OS noise
Thumbs.db
Desktop.ini
.DS_Store
