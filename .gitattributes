# Normalize text line endings so CI checkouts match the hashes committed in
# fixture package manifests (Windows runners default to autocrlf=true).
* text=auto

*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sln text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.cmd text eol=lf
*.bat text eol=lf
*.py text eol=lf
*.proto text eol=lf
*.iss text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.config text eol=lf
*.xml text eol=lf

*.dll binary
*.pdb binary
*.exe binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.zip binary
*.nupkg binary
*.tgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pyc binary
