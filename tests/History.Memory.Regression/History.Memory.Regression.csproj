<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HistorySource Condition="'$(HistorySource)' == ''">../../src/MyPowerTools.Runtime</HistorySource>
    <DefineConstants Condition="'$(HistoryBaseline)' == 'true'">$(DefineConstants);HISTORY_BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(HistorySource)/CommandHistory.cs" Link="CommandHistory.cs" />
    <Compile Include="$(HistorySource)/NotificationCenter.cs" Link="NotificationCenter.cs" />
    <Compile Include="../../src/MyPowerTools.Runtime/LogRouter.cs" Link="LogRouter.cs" />
    <Compile Include="$(HistorySource)/BoundedHistoryBuffer.cs" Link="BoundedHistoryBuffer.cs" Condition="'$(HistoryBaseline)' != 'true'" />
    <ProjectReference Include="../../src/MyPowerTools.Abstractions/MyPowerTools.Abstractions.csproj" />
  </ItemGroup>
</Project>
