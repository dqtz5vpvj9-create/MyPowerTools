<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <LogRouterSource Condition="'$(LogRouterSource)' == ''">../../src/MyPowerTools.Runtime/LogRouter.cs</LogRouterSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LogRouterSource)" Link="LogRouter.cs" />
    <Compile Include="../../src/MyPowerTools.Abstractions/MptLogRedactor.cs" Link="MptLogRedactor.cs" />
  </ItemGroup>
</Project>
