{
  "schemaVersion": "1.0",
  "id": "input-monitor",
  "packageId": "input-monitor",
  "displayName": "Input Monitor",
  "version": "0.1.3",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "inproc-dotnet",
      "priority": 100,
      "platforms": ["windows-x64", "windows-arm64"],
      "assembly": "InputMonitor.MyPowerTools.dll",
      "type": "InputMonitor.MyPowerTools.InputMonitorModule"
    }
  ],
  "capabilities": [
    "lifecycle",
    "status",
    "commands",
    "settings",
    "logs",
    "dashboardCard",
    "detailPage"
  ],
  "runtimePolicy": {
    "preferred": "inproc",
    "allowInProc": true,
    "inProcRules": {
      "maxCallMs": 15000,
      "allowNativeDll": true,
      "allowWindow": true,
      "allowBackgroundThreads": true,
      "loadContext": "collectible",
      "shadowCopy": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "inproc-or-sidecar",
      "nativeHardware": "inproc-or-sidecar"
    }
  },
  "requires": [],
  "permissions": [],
  "hotkeys": [],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "tools": ["ui/tool.json"],
  "uiSurfaces": [
    "ui/dashboard-card.json",
    "ui/detail-page.json",
    "ui/settings.json",
    "ui/logs.json"
  ]
}
