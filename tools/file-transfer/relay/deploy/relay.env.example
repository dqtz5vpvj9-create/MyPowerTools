# MyPowerTools file relay - /etc/mpt-relay/relay.env
#
# EnvironmentFile for mpt-relay.service. Every key is optional; the value shown is the
# built-in default. Command line flags override this file, and this file overrides the
# defaults. Keys with a prefix that is not MPT_RELAY_ are ignored.
#
# After editing: systemctl restart mpt-relay && systemctl status mpt-relay

# --- transport (loopback only; nginx terminates TLS) --------------------------------
MPT_RELAY_HOST=127.0.0.1
MPT_RELAY_PORT=18765
MPT_RELAY_BASE_PATH=/mpt/relay
MPT_RELAY_SOCKET_TIMEOUT_SECONDS=120
MPT_RELAY_MAX_CONNECTIONS=64
# Must stay well below the nginx proxy_read_timeout (70s in the shipped snippet).
MPT_RELAY_LONGPOLL_MAX_SECONDS=25
# Wall-clock budget for reading ONE request body (not per read): a slow-drip client cannot
# hold a connection slot forever. Long polls have no body and are not affected.
MPT_RELAY_BODY_BUDGET_SECONDS=900

# --- storage quotas (bytes) ---------------------------------------------------------
MPT_RELAY_DATA_DIR=/var/lib/mpt-relay
MPT_RELAY_PER_CONVERSATION_BYTES=1073741824
MPT_RELAY_GLOBAL_BYTES=8589934592
MPT_RELAY_MAX_FILE_BYTES=536870912
MPT_RELAY_MAX_CONVERSATIONS=10000
# Pairing inboxes (device-to-device delivery) are a separate kind of namespace.
MPT_RELAY_MAX_INBOXES=10000
MPT_RELAY_MAX_ENTRIES_PER_CONVERSATION=20000
MPT_RELAY_MAX_PATH_DEPTH=8
# 0 disables reaping. When > 0 only namespaces with zero bytes, revision 0 and no recent
# authentication are removed; user files are never deleted silently.
MPT_RELAY_EMPTY_NAMESPACE_TTL_DAYS=0

# --- abuse control ------------------------------------------------------------------
# New namespaces per client address per hour (the relay is on the open internet).
MPT_RELAY_REGISTER_PER_IP_PER_HOUR=5
MPT_RELAY_REGISTER_GLOBAL_PER_HOUR=100
# "receiver has not registered this inbox yet" probes are retryable (503), so they get their
# own generous bucket instead of the authentication failure window.
MPT_RELAY_NOT_READY_PER_IP_PER_MINUTE=120
# Failed Basic attempts per address inside the window, then 429 until the window passes.
# 0 disables the window (shared NAT / local probing only).
MPT_RELAY_AUTH_FAILURES_PER_IP=60
MPT_RELAY_AUTH_FAILURE_WINDOW_SECONDS=300
MPT_RELAY_MAX_CONCURRENT_AUTH=8
# Hard ceiling on tracked client addresses for the limiters (oldest key is evicted first).
MPT_RELAY_MAX_TRACKED_ADDRESSES=4096
# PBKDF2-HMAC-SHA256 iterations for the stored credential digest. Raise on fast hardware.
MPT_RELAY_KDF_ITERATIONS=120000
# Trust X-Real-IP / X-Forwarded-For, but only from these peer addresses.
MPT_RELAY_TRUST_PROXY_HEADERS=1
MPT_RELAY_TRUSTED_PROXIES=127.0.0.1,::1
# 1: a client that speaks only WebDAV may create its namespace on first use (the existing
#    OpenListClient path, with nothing but an address and a credential pair).
# 0 (first-up default): only POST /mpt/relay/v1/conversations creates a namespace, so an
#    unauthenticated DAV request cannot mint one. PublicRelayClient registers first anyway.
MPT_RELAY_DAV_AUTO_REGISTER=0

# --- diagnostics --------------------------------------------------------------------
MPT_RELAY_LOG_LEVEL=info
# 1: conversation ids are masked in log lines (self-ab12...cd34). Never log credentials:
# the Authorization header and request bodies are not logged at all, at any level.
MPT_RELAY_MASK_LOG_IDS=1
