<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- System.Net.Http.Json provides ReadFromJsonAsync for the WebDAV content reads. -->
    <Using Include="System.Net.Http.Json" />
    <!-- The tests inject the simulated public relay endpoint; production keeps the fixed HTTPS address. -->
    <InternalsVisibleTo Include="FileTransfer.Core.Tests" />
  </ItemGroup>
</Project>
