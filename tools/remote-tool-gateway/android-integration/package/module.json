{
  "schemaVersion": "1.0",
  "id": "mobile-tool-control",
  "packageId": "mobile-tool-control",
  "displayName": "电脑工具",
  "version": "0.1.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "inproc-dotnet",
      "priority": 100,
      "platforms": [
        "android-arm64",
        "android-x64"
      ],
      "assembly": "MobileToolControl.Android.dll",
      "type": "MobileToolControl.Android.MobileToolControlModule"
    }
  ],
  "capabilities": [
    "lifecycle",
    "status",
    "commands",
    "settings",
    "logs",
    "dashboardCard",
    "detailPage"
  ],
  "runtimePolicy": {
    "preferred": "inproc",
    "allowInProc": true,
    "inProcRules": {
      "maxCallMs": 120000,
      "allowNativeDll": false,
      "allowWindow": false,
      "allowBackgroundThreads": true,
      "loadContext": "collectible",
      "shadowCopy": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "inproc-or-sidecar",
      "systemMutation": "unsupported",
      "nativeHardware": "unsupported",
      "elevatedWrite": "unsupported",
      "externalProcess": "unsupported"
    }
  },
  "requires": [
    {
      "capability": "secret.store",
      "required": true,
      "reason": "每台电脑的 grant token 只能保存在平台凭据库，devices.json 只保存地址与名称"
    }
  ],
  "permissions": [],
  "hotkeys": [],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "tools": [
    "ui/tool.json"
  ],
  "uiSurfaces": [
    "ui/dashboard-card.json",
    "ui/detail-page.json",
    "ui/settings.json",
    "ui/logs.json"
  ]
}
