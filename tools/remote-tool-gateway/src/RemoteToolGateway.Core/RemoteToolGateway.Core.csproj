<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RemoteToolGateway.Core</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Tailnet-bound HTTP gateway that exposes an explicitly granted subset of the MyPowerTools HostControl catalog to a paired phone.</Description>
    <!--
      A packaged module is loaded into a collectible AssemblyLoadContext whose dependency resolver
      reads the module's .deps.json. Copying the lock-file assemblies next to the module keeps the
      HostControl client, protobuf and gRPC dependencies resolvable from the package itself instead
      of relying on a machine-global NuGet cache.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The gateway reuses the published HostControl client contract instead of reaching into
      Runner internals: HostControl.Client speaks the same local NamedPipe/UnixSocket IPC as the
      Shell, so execution, cancellation and runtime policy stay in the Runner.
    -->
    <PackageReference Include="MyPowerTools.ToolSdk" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.Platform.Abstractions" Version="0.3.0" />
    <PackageReference Include="MyPowerTools.HostControl.Client" Version="0.2.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RemoteToolGateway.Core.Tests" />
  </ItemGroup>
</Project>
