{
  "schemaVersion": "1.0",
  "id": "remote-tool-gateway",
  "packageId": "remote-tool-gateway",
  "displayName": "远程工具访问",
  "version": "0.1.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "inproc-dotnet",
      "priority": 100,
      "platforms": [
        "windows-x64",
        "windows-arm64",
        "macos-arm64",
        "macos-x64",
        "linux-x64"
      ],
      "assembly": "RemoteToolGateway.MyPowerTools.dll",
      "type": "RemoteToolGateway.MyPowerTools.RemoteToolGatewayModule"
    }
  ],
  "capabilities": [
    "lifecycle",
    "status",
    "commands",
    "settings",
    "logs",
    "dashboardCard",
    "detailPage"
  ],
  "runtimePolicy": {
    "preferred": "inproc",
    "allowInProc": true,
    "inProcRules": {
      "maxCallMs": 600000,
      "allowNativeDll": false,
      "allowWindow": false,
      "allowBackgroundThreads": true,
      "loadContext": "collectible",
      "shadowCopy": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "inproc-or-sidecar",
      "systemMutation": "broker-required",
      "nativeHardware": "inproc-or-sidecar",
      "elevatedWrite": "broker-required",
      "externalProcess": "inproc-or-sidecar"
    }
  },
  "requires": [
    {
      "capability": "secret.store",
      "required": true,
      "reason": "Each phone's grant token is kept in the platform secret store; only the reference is written to grants.json."
    }
  ],
  "permissions": [],
  "hotkeys": [],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "tools": [
    "ui/tool.json"
  ],
  "uiSurfaces": [
    "ui/control-page.json"
  ]
}
