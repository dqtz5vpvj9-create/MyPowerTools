<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:adaptive="using:MyPowerTools.AvaloniaSdk"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:PasteImage.Surface.ViewModels"
             x:Class="PasteImage.Surface.Views.PasteImageView"
             x:DataType="vm:PasteImageViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource MptBrushTextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.history-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
      <Setter Property="Padding" Value="0,2" />
    </Style>
    <Style Selector="Border.history-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource MptBrushNavigationHover}" />
    </Style>
    <Style Selector="Border.history-row.selected">
      <Setter Property="Background" Value="{DynamicResource MptBrushNavigationSelected}" />
    </Style>
    <Style Selector="Border.history-row.selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource MptBrushNavigationSelected}" />
    </Style>
    <Style Selector="controls|MptButton.history-select">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,8" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="controls|MptButton.history-select:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="controls|MptButton.history-select:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <Border Padding="40,24,40,40"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Top">
    <StackPanel Spacing="16" MaxWidth="1100">
      <Border Background="{DynamicResource MptBrushInfoBackground}"
              BorderBrush="{DynamicResource MptBrushInfo}"
              BorderThickness="1"
              CornerRadius="{DynamicResource MptRadiusCard}"
              Padding="24,20">
        <Grid adaptive:MptAdaptiveLayout.StackBelow="600" ColumnDefinitions="*,Auto" ColumnSpacing="24">
          <StackPanel Spacing="6">
            <TextBlock Text="复制、上传、粘贴"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="优先复用剪贴板中的原生 PNG，单次 SSH 连接完成上传，远端路径写回剪贴板后自动发送可配置的粘贴快捷键。"
                       Classes="secondary"
                       MaxWidth="720" />
          </StackPanel>
          <Border Grid.Column="1"
                  Background="{DynamicResource MptBrushSurfaceRaised}"
                  BorderBrush="{DynamicResource MptBrushBorder}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource MptRadiusControl}"
                  Padding="12,7"
                  VerticalAlignment="Center">
            <TextBlock Text="Ctrl + Alt + V"
                       FontFamily="Consolas, Cascadia Code, monospace"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MptBrushAccent}" />
          </Border>
        </Grid>
      </Border>

      <Grid adaptive:MptAdaptiveLayout.StackBelow="600" ColumnDefinitions="*,*" ColumnSpacing="14">
        <Border Classes="card" MinHeight="132">
          <StackPanel Spacing="10">
            <TextBlock Text="上传目标" Classes="secondary" />
            <TextBlock Text="{Binding Destination}"
                       FontSize="16"
                       FontWeight="Medium"
                       TextWrapping="Wrap" />
            <TextBlock Text="SSH 配置中的主机与远端目录"
                       FontSize="12"
                       Classes="secondary" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" MinHeight="132">
          <StackPanel Spacing="10">
            <TextBlock Text="连接状态" Classes="secondary" />
            <StackPanel adaptive:MptAdaptiveLayout.StackBelow="480" Orientation="Horizontal" Spacing="8">
              <Border Width="10"
                      Height="10"
                      CornerRadius="5"
                      Background="{Binding StatusBrush}"
                      VerticalAlignment="Center" />
              <TextBlock Text="{Binding ConnectionStatus}"
                         Foreground="{Binding StatusBrush}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Health}" TextWrapping="Wrap" />
            <TextBlock Text="检查 Windows OpenSSH 与目标配置"
                       FontSize="12"
                       Classes="secondary" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel adaptive:MptAdaptiveLayout.StackBelow="480" Orientation="Horizontal" Spacing="10">
        <controls:MptButton Content="上传剪贴板图片"
                            Command="{Binding UploadCommand}"
                            IsEnabled="{Binding CanUpload}"
                            Classes="MptPrimaryButton" />
        <controls:MptButton Content="重新检查"
                            Command="{Binding RefreshCommand}" />
      </StackPanel>

      <ProgressBar IsIndeterminate="True"
                   IsVisible="{Binding IsBusy}"
                   Width="150"
                   Height="3"
                   HorizontalAlignment="Left" />

      <Border Background="{Binding MessageBackground}"
              BorderBrush="{Binding MessageForeground}"
              BorderThickness="0"
              CornerRadius="{DynamicResource MptRadiusControl}"
              Padding="16,12">
        <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
          <TextBlock Text="{Binding MessageIcon}"
                     FontWeight="Bold"
                     Foreground="{Binding MessageForeground}"
                     VerticalAlignment="Top" />
          <TextBlock Grid.Column="1"
                     Text="{Binding Message}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Grid adaptive:MptAdaptiveLayout.StackBelow="600" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="14">
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="图片预览" Classes="section-title" />
            <TextBlock Text="默认显示最近一次，点击右侧记录可切换" FontSize="12" Classes="secondary" />
            <Grid MinHeight="230">
              <Image Source="{Binding Preview}"
                     IsVisible="{Binding HasPreview}"
                     Stretch="Uniform"
                     MaxHeight="280"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
              <TextBlock Text="{Binding PreviewPlaceholder}"
                         IsVisible="{Binding IsPreviewEmpty}"
                         Classes="secondary"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding PreviewMeta}"
                       FontSize="12"
                       Classes="secondary" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="最近上传记录" Classes="section-title" />
            <TextBlock Text="点击一条记录查看对应图片" FontSize="12" Classes="secondary" />
            <TextBlock Text="暂无上传记录"
                       IsVisible="{Binding IsHistoryEmpty}"
                       Classes="secondary"
                       Margin="0,12" />
            <ItemsControl ItemsSource="{Binding History}" IsVisible="{Binding HasHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UploadHistoryRow">
                  <Border Classes="history-row"
                          Classes.selected="{Binding IsSelected}"
                          BorderBrush="{DynamicResource MptBrushDivider}"
                          BorderThickness="0,1,0,0"
                          Margin="0,2">
                    <Grid adaptive:MptAdaptiveLayout.StackBelow="600" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <controls:MptButton Classes="history-select"
                                          Command="{Binding SelectCommand}"
                                          AutomationProperties.Name="查看这张图片"
                                          ToolTip.Tip="查看这张图片">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding RemotePath}"
                                     FontWeight="Medium"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding UploadedAtText}"
                                     Foreground="{DynamicResource MptBrushTextSecondary}"
                                     FontSize="12" />
                        </StackPanel>
                      </controls:MptButton>
                      <controls:MptButton Grid.Column="1"
                                          Content="复制"
                                          Command="{Binding CopyCommand}"
                                          VerticalAlignment="Center"
                                          Padding="8,4"
                                          FontSize="12" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Text="远端主机、目录、上传超时和上传后的粘贴快捷键（默认 Ctrl+Shift+V）可在 Paste Image 设置中修改。"
                 Classes="secondary" />
    </StackPanel>
  </Border>
</UserControl>
