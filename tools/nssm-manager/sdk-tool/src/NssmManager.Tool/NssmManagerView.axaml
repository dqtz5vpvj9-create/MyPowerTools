<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:NssmManager.Tool" xmlns:contracts="using:NssmManager.Contracts" x:Class="NssmManager.Tool.NssmManagerView" x:DataType="vm:NssmManagerViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/></Style>
    <Style Selector="TextBlock.h"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="{DynamicResource MptBrushTextSecondary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBox"><Setter Property="MinWidth" Value="260"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource MptBrushAppBackground}">
    <Border Margin="24,18,24,10" Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4"><TextBlock Text="NSSM 服务管理器" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="C# 兼容实现：管理 Windows 服务包装、进程监管、I/O、轮转和 Hooks。" Classes="hint"/><TextBlock Text="{Binding Status}" Classes="hint" FontSize="12"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="新建" Command="{Binding NewCommand}"/><Button Content="刷新" Command="{Binding RefreshCommand}"/><Button Content="启动" Command="{Binding StartCommand}" IsEnabled="{Binding IsExisting}"/><Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsExisting}"/><Button Content="重启" Command="{Binding RestartCommand}" IsEnabled="{Binding IsExisting}"/><Button Content="轮转" Command="{Binding RotateCommand}" IsEnabled="{Binding IsExisting}"/><Button Content="删除" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsExisting}"/><Button Content="预览更改" Command="{Binding PreviewCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="保存" Classes="accent" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}"/></StackPanel>
      </Grid>
    </Border>
    <ProgressBar Grid.Row="1" Height="3" Margin="24,0" IsIndeterminate="True" IsVisible="{Binding Busy}"/>
    <Grid Grid.Row="2" ColumnDefinitions="280,*" Margin="24,10,24,24" ColumnSpacing="12">
      <Border Classes="card"><Grid RowDefinitions="Auto,*"><TextBlock Text="兼容服务" Classes="h" Margin="0,0,0,8"/><ListBox Grid.Row="1" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}"><ListBox.ItemTemplate><DataTemplate x:DataType="contracts:NssmServiceSnapshot"><StackPanel Margin="4" Spacing="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" Classes="hint" FontSize="12"/><TextBlock Text="{Binding State}" Classes="hint" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
      <Border Grid.Column="1" Classes="card">
        <TabControl IsEnabled="{Binding CanEdit}" SelectedIndex="{Binding SelectedTabIndex}">
          <TabItem Header="应用"><ScrollViewer><StackPanel Margin="8" Spacing="9"><TextBlock Text="应用" Classes="h"/><TextBlock Text="程序"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Application}"/><Button Grid.Column="1" Content="浏览…" Click="BrowseApplication_Click"/></Grid><TextBlock Text="参数"/><TextBox Text="{Binding Parameters}" AcceptsReturn="True" MinHeight="70"/><TextBlock Text="工作目录"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Directory}"/><Button Grid.Column="1" Content="浏览…" Click="BrowseDirectory_Click"/></Grid><TextBlock Text="替换环境块（每行 KEY=VALUE）"/><TextBox Text="{Binding EnvironmentReplaceText}" AcceptsReturn="True" MinHeight="80"/><TextBlock Text="追加环境变量（每行 KEY=VALUE）"/><TextBox Text="{Binding EnvironmentText}" AcceptsReturn="True" MinHeight="80"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="优先级"/><TextBox Text="{Binding Priority}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="CPU 亲和性"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"><CheckBox Content="All" IsChecked="{Binding !AffinityEnabled}" Click="AffinityAll_Click"/><TextBox Grid.Column="1" Text="{Binding Affinity}" IsEnabled="{Binding AffinityEnabled}"/></Grid></StackPanel></Grid></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="详细信息"><ScrollViewer><StackPanel Margin="8" Spacing="9"><TextBlock Text="服务名"/><TextBox Text="{Binding Name}" IsReadOnly="{Binding IsExisting}"/><TextBlock Text="显示名"/><TextBox Text="{Binding DisplayName}"/><TextBlock Text="描述"/><TextBox Text="{Binding Description}" AcceptsReturn="True"/><TextBlock Text="启动类型"/><ComboBox ItemsSource="{Binding StartupTypes}" SelectedItem="{Binding StartupType}"/><CheckBox Content="交互式服务（仅 LocalSystem）" IsChecked="{Binding Interactive}" IsEnabled="{Binding InteractiveLogonEnabled}"/><TextBlock Text="依赖服务（每行一个）"/><TextBox Text="{Binding DependenciesText}" AcceptsReturn="True"/><TextBlock Text="依赖组（每行一个）"/><TextBox Text="{Binding DependencyGroupsText}" AcceptsReturn="True"/><TextBlock Text="SCM Environment（每行 KEY=VALUE）"/><TextBox Text="{Binding ServiceEnvironmentText}" AcceptsReturn="True"/><TextBlock Text="服务账户"/><TextBox Text="{Binding Account}"/><TextBlock Text="账户密码（仅经当前用户管道及 CryptProtectMemory 传给 Elevated Broker）"/><TextBox Text="{Binding Password}" PasswordChar="●" IsEnabled="{Binding CredentialsEnabled}"/></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="I/O"><ScrollViewer><StackPanel Margin="8" Spacing="9"><TextBlock Text="标准输入文件"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Stdin}"/><Button Grid.Column="1" Content="浏览…" Click="BrowseStdin_Click"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="stdin share"/><NumericUpDown Value="{Binding StdinShare}" Maximum="7"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="disposition"/><NumericUpDown Value="{Binding StdinDisposition}" Minimum="1" Maximum="5"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="flags"/><NumericUpDown Value="{Binding StdinFlags}" Maximum="4294967295"/></StackPanel></Grid><TextBlock Text="标准输出文件"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Stdout}"/><Button Grid.Column="1" Content="浏览…" Click="BrowseStdout_Click"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="stdout share"/><NumericUpDown Value="{Binding StdoutShare}" Maximum="7"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="disposition"/><NumericUpDown Value="{Binding StdoutDisposition}" Minimum="1" Maximum="5"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="flags"/><NumericUpDown Value="{Binding StdoutFlags}" Maximum="4294967295"/></StackPanel></Grid><CheckBox Content="stdout copy-and-truncate" IsChecked="{Binding StdoutCopyAndTruncate}"/><TextBlock Text="标准错误文件"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding Stderr}"/><Button Grid.Column="1" Content="浏览…" Click="BrowseStderr_Click"/></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="stderr share"/><NumericUpDown Value="{Binding StderrShare}" Maximum="7"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="disposition"/><NumericUpDown Value="{Binding StderrDisposition}" Minimum="1" Maximum="5"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="flags"/><NumericUpDown Value="{Binding StderrFlags}" Maximum="4294967295"/></StackPanel></Grid><CheckBox Content="stderr copy-and-truncate" IsChecked="{Binding StderrCopyAndTruncate}"/><CheckBox Content="不创建控制台" IsChecked="{Binding NoConsole}"/></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="轮转"><StackPanel Margin="8" Spacing="9"><CheckBox Content="服务启动前轮转" IsChecked="{Binding RotateFiles}"/><CheckBox Content="运行期间在线轮转" IsChecked="{Binding RotateOnline}" IsEnabled="{Binding RotationOptionsEnabled}"/><CheckBox Content="为每行添加时间戳" IsChecked="{Binding TimestampLog}"/><TextBlock Text="最小文件大小（字节，64 位）"/><NumericUpDown Value="{Binding RotateBytes}" Maximum="18446744073709551615" IsEnabled="{Binding RotationOptionsEnabled}"/><TextBlock Text="最小文件年龄（秒）"/><NumericUpDown Value="{Binding RotateSeconds}" Maximum="4294967295" IsEnabled="{Binding RotationOptionsEnabled}"/><TextBlock Text="轮转延迟（毫秒）"/><NumericUpDown Value="{Binding RotateDelay}" Maximum="4294967295"/></StackPanel></TabItem>
          <TabItem Header="退出与停止"><ScrollViewer><StackPanel Margin="8" Spacing="9"><TextBlock Text="默认退出动作"/><ComboBox ItemsSource="{Binding ExitActions}" SelectedItem="{Binding ExitAction}"/><TextBlock Text="按退出码规则（每行 CODE=ACTION）"/><TextBox Text="{Binding ExitRulesText}" AcceptsReturn="True" MinHeight="110"/><TextBlock Text="重启延迟（毫秒）"/><NumericUpDown Value="{Binding RestartDelay}" Maximum="4294967295"/><TextBlock Text="启动节流（毫秒）"/><NumericUpDown Value="{Binding Throttle}" Maximum="4294967295"/><TextBlock Text="停止阶段跳过位掩码"/><NumericUpDown Value="{Binding StopMethodSkip}" Maximum="15"/><Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"><StackPanel><TextBlock Text="Console 超时"/><NumericUpDown Value="{Binding StopConsole}" Maximum="4294967295" IsEnabled="{Binding ConsoleTimeoutEnabled}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Window 超时"/><NumericUpDown Value="{Binding StopWindow}" Maximum="4294967295" IsEnabled="{Binding WindowTimeoutEnabled}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Threads 超时"/><NumericUpDown Value="{Binding StopThreads}" Maximum="4294967295" IsEnabled="{Binding ThreadsTimeoutEnabled}"/></StackPanel></Grid><CheckBox Content="停止时终止整个进程树" IsChecked="{Binding KillTree}"/></StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Hooks"><StackPanel Margin="8" Spacing="9"><TextBlock Text="Hooks" Classes="h"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><ComboBox ItemsSource="{Binding HookEvents}" SelectedItem="{Binding SelectedHookEvent}"/><ComboBox Grid.Column="1" ItemsSource="{Binding AvailableHookActions}" SelectedItem="{Binding SelectedHookAction}"/></Grid><TextBlock Text="当前 Hook 命令"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding SelectedHookCommand}" LostFocus="HookCommand_LostFocus"/><Button Grid.Column="1" Content="浏览…" Click="BrowseHook_Click"/></Grid><TextBlock Text="每行 EVENT/ACTION=COMMAND，例如 Start/Pre=C:\scripts\prepare.cmd" Classes="hint"/><CheckBox Content="Hook 共享应用输出句柄" IsChecked="{Binding RedirectHookOutput}"/><TextBox Text="{Binding HooksText}" AcceptsReturn="True" MinHeight="190"/></StackPanel></TabItem>
          <TabItem Header="兼容性"><StackPanel Margin="8" Spacing="12"><TextBlock Text="宿主兼容状态" Classes="h"/><TextBlock Text="{Binding Compatibility}" Classes="hint"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="迁移到 C# nssm-manager.exe" Command="{Binding MigrateCommand}"/><Button Content="恢复迁移前宿主" Command="{Binding RollbackCommand}"/></StackPanel><TextBlock Text="迁移会先停止服务并保存 SCM 配置、ImagePath、完整 Parameters 树及服务状态；失败时执行验证回滚。" Classes="hint"/><TextBlock Text="草稿与影响范围" Classes="h" Margin="0,10,0,0"/><TextBox Text="{Binding Impact}" IsReadOnly="True" AcceptsReturn="True" MinHeight="150" TextWrapping="Wrap"/><CheckBox Content="我已核对以上变更，并确认执行" IsChecked="{Binding ImpactConfirmed}"/></StackPanel></TabItem>
        </TabControl>
      </Border>
    </Grid>
  </Grid>
</UserControl>
