<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The Android application targets net10.0-android, so its Android-free rules are linked into this
      assembly and tested on a build machine without a device, an emulator or the Android workload.
      Only files that never touch the Android SDK may be listed here; the camera activity and the
      shell host stay out and are covered by the on-device acceptance run.

      MobileQrScanner.cs is linked from Platform.Abstractions because it is the shared classifier the
      scanner, the Shell and the import commands all read the same rules from.
    -->
    <Compile Include="../../../MyPowerTools.Platform.Abstractions/MobileQrScanner.cs" Link="MobileQrScanner.cs" />
    <Compile Include="../../Pairing/PairingCodeSession.cs" Link="Pairing/PairingCodeSession.cs" />
    <Compile Include="../../Pairing/ScanRequestRegistry.cs" Link="Pairing/ScanRequestRegistry.cs" />
    <Compile Include="../../Pairing/ShareActivation.cs" Link="Pairing/ShareActivation.cs" />
    <Compile Include="../../Pairing/SharedFileNames.cs" Link="Pairing/SharedFileNames.cs" />
    <Compile Include="../../Pairing/MptQrCodeDecoder.cs" Link="Pairing/MptQrCodeDecoder.cs" />
    <Compile Include="../../Input/ActiveTouchSequences.cs" Link="Input/ActiveTouchSequences.cs" />
    <Compile Include="../../Input/AndroidDispatcherClock.cs" Link="Input/AndroidDispatcherClock.cs" />
    <Compile Include="../../AndroidStartupView.cs" Link="AndroidStartupView.cs" />
    <Compile Include="../../Input/AndroidImeHost.cs" Link="Input/AndroidImeHost.cs" />
    <Compile Include="../../Rendering/SurfaceLifetimeGlPlatformSurface.cs" Link="Rendering/SurfaceLifetimeGlPlatformSurface.cs" />
    <Compile Include="../../../MyPowerTools.AvaloniaSdk/CloudAuthorization.cs" Link="CloudAuthorization/CloudCallbackRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- ZXing.Net is the decoder the app uses, so the round-trip test proves the shipped decoder
         reads a QR code generated by the same library version. -->
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
