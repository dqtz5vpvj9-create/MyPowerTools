<?xml version="1.0" encoding="utf-8"?>
<!--
  The application window theme.

  It exists for one reason: the frame Android draws before Avalonia has rendered. The window
  background is the mobile page colour, the status and navigation bars take the page colour with
  dark icons in light mode (values-night switches the icons to light), and the action bar is gone.

  Theme.AppCompat.DayNight.NoActionBar is still the parent, so the activity keeps the AppCompat
  behaviour Avalonia's Android backend relies on, and the whole theme switches on the system night
  mode rather than on a hard-coded light palette.
-->
<resources>
  <style name="Theme.MyPowerTools" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/mpt_mobile_page</item>
    <item name="android:statusBarColor">@color/mpt_mobile_page</item>
    <item name="android:navigationBarColor">@color/mpt_mobile_page</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
  </style>

  <!-- The scanner is a full-screen camera surface; a bright launch frame would flash before it. -->
  <style name="Theme.MyPowerTools.Scanner" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/mpt_scanner_background</item>
    <item name="android:statusBarColor">@color/mpt_scanner_background</item>
    <item name="android:navigationBarColor">@color/mpt_scanner_background</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
  </style>
</resources>
