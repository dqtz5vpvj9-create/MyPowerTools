<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phone page for the "电脑工具" (remote tool control) module.

    The Android package route points at
    surface/MyPowerTools.MobileToolControl.dll + MyPowerTools.MobileToolControl.MobileToolControlSurfaceFactory,
    so this assembly is loaded exactly like every other dynamically catalogued MyPowerTools dotnet
    surface. All effects go through the mobile-tool-control module commands; the page owns no socket,
    no credential and no HTTP client.

    The page renders the computer's real catalog only: titles, descriptions, authorization flags and
    parameters come from GET /catalog by way of the module. Nothing on this page fabricates a status,
    a statistic or a result for a computer the user has not reached.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>MyPowerTools.MobileToolControl</AssemblyName>
    <RootNamespace>MyPowerTools.MobileToolControl</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="MyPowerTools.ToolSdk" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.AvaloniaSdk" Version="0.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyPowerTools.MobileToolControl.Tests" />
    <!-- The real-combination suite drives the real view model against the real gateway. -->
    <InternalsVisibleTo Include="MyPowerTools.MobileToolControl.Integration.Tests" />
  </ItemGroup>

</Project>
