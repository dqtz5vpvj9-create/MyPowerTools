<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- HostControl is now split into Contracts/Client/Server. This project is a compatibility
         facade that type-forwards to the split assemblies so existing references keep working
         during the migration. New code should reference the specific split assembly. -->
    <ProjectReference Include="..\MyPowerTools.HostControl.Contracts\MyPowerTools.HostControl.Contracts.csproj" />
    <ProjectReference Include="..\MyPowerTools.HostControl.Client\MyPowerTools.HostControl.Client.csproj" />
    <ProjectReference Include="..\MyPowerTools.HostControl.Server\MyPowerTools.HostControl.Server.csproj" />
  </ItemGroup>

</Project>
