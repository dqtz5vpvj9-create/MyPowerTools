<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>powertoold</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ModuleRuntimeRoot>$(MSBuildProjectDirectory)\..\..\modules\android-tools-suite\windows\x64</ModuleRuntimeRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AndroidTools.MyPowerTools\AndroidTools.MyPowerTools.csproj" />
    <ProjectReference Include="..\MyPowerTools.Protocol\MyPowerTools.Protocol.csproj" />
    <ProjectReference Include="..\MyPowerTools.Abstractions\MyPowerTools.Abstractions.csproj" />
  </ItemGroup>

  <Target Name="CopyPowertooldToPackage" AfterTargets="Build">
    <MakeDir Directories="$(ModuleRuntimeRoot)" />
    <ItemGroup>
      <PowertooldRuntimeFiles Include="$(TargetDir)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PowertooldRuntimeFiles)" DestinationFolder="$(ModuleRuntimeRoot)" SkipUnchangedFiles="true" />
  </Target>

</Project>
