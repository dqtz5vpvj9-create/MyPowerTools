<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(OS)' == 'Windows_NT'">$(MSBuildProjectDirectory)\..\..\assets\MyPowerTools.ico</ApplicationIcon>
    <BuildWindowsWebToolHost Condition="'$(OS)' == 'Windows_NT' and '$(RuntimeIdentifier)' == ''">true</BuildWindowsWebToolHost>
    <BuildWindowsWebToolHost Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">true</BuildWindowsWebToolHost>
    <WebToolHostProject>$(MSBuildProjectDirectory)\..\MyPowerTools.WebToolHost\MyPowerTools.WebToolHost.csproj</WebToolHostProject>
    <WebToolHostTargetFramework>net10.0-windows10.0.19041.0</WebToolHostTargetFramework>
    <!-- src/Directory.Build.props enables the artifacts output layout, which names
         directories <lowercase configuration>[_<runtime identifier>]. -->
    <WebToolHostOutputDirName>$(Configuration.ToLowerInvariant())</WebToolHostOutputDirName>
    <WebToolHostOutputDirName Condition="'$(RuntimeIdentifier)' != ''">$(Configuration.ToLowerInvariant())_$(RuntimeIdentifier)</WebToolHostOutputDirName>
    <WebToolHostBuildOutput>$(ArtifactsPath)\bin\MyPowerTools.WebToolHost\$(WebToolHostOutputDirName)\</WebToolHostBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyPowerTools.Abstractions\MyPowerTools.Abstractions.csproj" />
    <ProjectReference Include="..\MyPowerTools.Protocol\MyPowerTools.Protocol.csproj" />
    <ProjectReference Include="..\MyPowerTools.Broker\MyPowerTools.Broker.csproj" />
    <ProjectReference Include="..\MyPowerTools.Platform\MyPowerTools.Platform.csproj" />
    <ProjectReference Include="..\MyPowerTools.Platform.Windows\MyPowerTools.Platform.Windows.csproj" />
    <ProjectReference Include="..\MyPowerTools.HostControl.Client\MyPowerTools.HostControl.Client.csproj" />
    <ProjectReference Include="..\MyPowerTools.ServiceManager.Client\MyPowerTools.ServiceManager.Client.csproj" />
    <ProjectReference Include="..\MyPowerTools.Ipc.Shared\MyPowerTools.Ipc.Shared.csproj" />
    <ProjectReference Include="..\MyPowerTools.UI\MyPowerTools.UI.csproj" />
    <ProjectReference Include="..\MyPowerTools.AvaloniaSdk\MyPowerTools.AvaloniaSdk.csproj" />
    <ProjectReference Include="..\MyPowerTools.WebSurface.Avalonia\MyPowerTools.WebSurface.Avalonia.csproj" />
    <ProjectReference Include="$(WebToolHostProject)"
                      Condition="'$(BuildWindowsWebToolHost)' == 'true'"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\MyPowerTools.ico"
                      Link="Assets\MyPowerTools.ico" />
  </ItemGroup>

  <!-- First-party tool UIs are now loaded dynamically as dotnet-surface packages via the
       DotnetSurfaceLoader (collectible AssemblyLoadContext). The Shell no longer compiles tool
       ViewModel/View/Service sources from the submodule integration directories. Tool navigation
       is driven entirely by the Tool Catalog; there are no hardcoded tool IDs or route switches. -->


  <Target Name="CopyWebToolHostForLocalRun"
          AfterTargets="Build"
          Condition="'$(BuildWindowsWebToolHost)' == 'true'">
    <ItemGroup>
      <_WebToolHostFiles Include="$(WebToolHostBuildOutput)**\*.*"
                         Exclude="$(WebToolHostBuildOutput)win-x64\**\*.*;$(WebToolHostBuildOutput)win-x86\**\*.*;$(WebToolHostBuildOutput)win-arm64\**\*.*;$(WebToolHostBuildOutput)publish\**\*.*" />
    </ItemGroup>
    <Error Condition="'@(_WebToolHostFiles)' == ''"
           Text="No WebToolHost build output was found under $(WebToolHostBuildOutput). A silent miss here ships a Shell that cannot host web tools." />
    <RemoveDir Directories="$(OutDir)WebToolHost" />
    <Copy SourceFiles="@(_WebToolHostFiles)"
          DestinationFiles="@(_WebToolHostFiles->'$(OutDir)WebToolHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Delete Files="$(OutDir)MyPowerTools.WebToolHost.exe;$(OutDir)MyPowerTools.WebToolHost.deps.json;$(OutDir)MyPowerTools.WebToolHost.runtimeconfig.json" />
  </Target>

  <Target Name="PublishWebToolHost"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildWindowsWebToolHost)' == 'true'">
    <RemoveDir Directories="$(PublishDir)WebToolHost" />
    <MSBuild Projects="$(WebToolHostProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)WebToolHost\;PublishSingleFile=false" />
  </Target>

</Project>
