<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SmartBirdIntegrationSource>$(MSBuildProjectDirectory)\..\..\tools\smartbird-thermostat\current-integration\src</SmartBirdIntegrationSource>
    <SmartBirdShellSource>$(SmartBirdIntegrationSource)\MyPowerTools.Shell.Avalonia</SmartBirdShellSource>
    <WebToolHostProject>$(SmartBirdIntegrationSource)\MyPowerTools.WebToolHost\MyPowerTools.WebToolHost.csproj</WebToolHostProject>
    <WebToolHostTargetFramework>net10.0-windows10.0.19041.0</WebToolHostTargetFramework>
    <WebToolHostBuildOutput>$(SmartBirdIntegrationSource)\MyPowerTools.WebToolHost\bin\$(Configuration)\$(WebToolHostTargetFramework)\</WebToolHostBuildOutput>
    <WebToolHostBuildOutput Condition="'$(RuntimeIdentifier)' != ''">$(SmartBirdIntegrationSource)\MyPowerTools.WebToolHost\bin\$(Configuration)\$(WebToolHostTargetFramework)\$(RuntimeIdentifier)\</WebToolHostBuildOutput>
    <AdbForwarderShellSource>$(MSBuildProjectDirectory)\..\..\tools\adb-forwarder\current-integration\src\MyPowerTools.Shell.Avalonia</AdbForwarderShellSource>
    <RemoteNotificationsShellSource>$(MSBuildProjectDirectory)\..\..\tools\remote-notifications\current-integration\src\MyPowerTools.Shell.Avalonia</RemoteNotificationsShellSource>
    <ScreenEaseShellSource>$(MSBuildProjectDirectory)\..\..\tools\screenease\current-integration\src\MyPowerTools.Shell.Avalonia</ScreenEaseShellSource>
    <DoubaoShellSource>$(MSBuildProjectDirectory)\..\..\tools\doubao-computer-use\current-integration\src\MyPowerTools.Shell.Avalonia</DoubaoShellSource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.HtmlRenderer" Version="12.0.0" />
    <PackageReference Include="Markdig" Version="1.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyPowerTools.Protocol\MyPowerTools.Protocol.csproj" />
    <ProjectReference Include="..\MyPowerTools.Broker\MyPowerTools.Broker.csproj" />
    <ProjectReference Include="..\MyPowerTools.Platform.Windows\MyPowerTools.Platform.Windows.csproj" />
    <ProjectReference Include="..\MyPowerTools.HostControl\MyPowerTools.HostControl.csproj" />
    <ProjectReference Include="..\MyPowerTools.ServiceManager.Client\MyPowerTools.ServiceManager.Client.csproj" />
    <ProjectReference Include="..\MyPowerTools.UI\MyPowerTools.UI.csproj" />
    <ProjectReference Include="..\MyPowerTools.AvaloniaSdk\MyPowerTools.AvaloniaSdk.csproj" />
    <ProjectReference Include="$(WebToolHostProject)"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\MyPowerTools.ico"
                      Link="Assets\MyPowerTools.ico" />
  </ItemGroup>

  <!-- First-party tool UIs are now loaded dynamically as dotnet-surface packages via the
       DotnetSurfaceLoader (collectible AssemblyLoadContext). The Shell no longer compiles tool
       ViewModel/View/Service sources from the submodule integration directories. Tool navigation
       is driven entirely by the Tool Catalog; there are no hardcoded tool IDs or route switches. -->


  <Target Name="CopyWebToolHostForLocalRun"
          AfterTargets="Build">
    <ItemGroup>
      <_WebToolHostFiles Include="$(WebToolHostBuildOutput)**\*.*"
                         Exclude="$(WebToolHostBuildOutput)win-x64\**\*.*;$(WebToolHostBuildOutput)win-x86\**\*.*;$(WebToolHostBuildOutput)win-arm64\**\*.*;$(WebToolHostBuildOutput)publish\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)WebToolHost" />
    <Copy SourceFiles="@(_WebToolHostFiles)"
          DestinationFiles="@(_WebToolHostFiles->'$(OutDir)WebToolHost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Delete Files="$(OutDir)MyPowerTools.WebToolHost.exe;$(OutDir)MyPowerTools.WebToolHost.deps.json;$(OutDir)MyPowerTools.WebToolHost.runtimeconfig.json" />
  </Target>

  <Target Name="PublishWebToolHost"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(PublishDir)WebToolHost" />
    <MSBuild Projects="$(WebToolHostProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)WebToolHost\;PublishSingleFile=false" />
  </Target>

</Project>
