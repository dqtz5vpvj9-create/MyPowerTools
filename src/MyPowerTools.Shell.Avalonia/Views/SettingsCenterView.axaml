<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.SettingsCenterView"
             x:DataType="vm:SettingsCenterViewModel">
  <StackPanel Margin="{DynamicResource MptPagePadding}" Spacing="{DynamicResource MptSpacingM}">
    <StackPanel Spacing="{DynamicResource MptSpacingXs}">
      <TextBlock Classes="MptPageTitle" Text="{Binding Title}" />
      <TextBlock Classes="MptPageSubtitle" Text="{Binding Subtitle}" />
    </StackPanel>

    <Border Classes="MptInset">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MptSpacingS}">
        <TextBlock Classes="MptMeta" Text="{Binding SelectedModuleId}" />
        <TextBlock Classes="MptMeta" Text="{Binding Revision}" />
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Modules}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ModulePickerItemViewModel">
          <Button Command="{Binding SelectCommand}" MinHeight="32" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock Text="{Binding DisplayName}" />
              <TextBlock Classes="MptMeta" Text="{Binding SelectionText}" IsVisible="{Binding IsSelected}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="MptPageSubtitle"
               Text="No modules."
               IsVisible="{Binding HasNoModules}" />

    <TextBlock Classes="MptMeta" Text="{Binding StatusText}" />
    <Border Classes="MptInset" IsVisible="{Binding HasSaveResult}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock FontWeight="SemiBold" Text="{Binding SaveResultTitle}" />
          <TextBlock Grid.Column="1" Classes="MptMeta" Text="{Binding SaveResultState}" />
        </Grid>
        <TextBlock Classes="MptMeta"
                   Text="{Binding SaveResultMessage}"
                   TextWrapping="Wrap" />
        <TextBlock Classes="MptMeta"
                   Text="{Binding SaveResultRevision}"
                   IsVisible="{Binding HasSaveResultRevision}" />
      </StackPanel>
    </Border>
    <Border Classes="MptInset">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptMeta" Text="{Binding ChangeSummary}" />
        <TextBlock Classes="MptMeta"
                   Text="{Binding ValidationMessage}"
                   IsVisible="{Binding HasValidationErrors}" />
        <TextBlock Classes="MptMeta"
                   Text="{Binding PatchPreview}"
                   IsVisible="{Binding HasPatchPreview}" />
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Fields}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SettingsFieldViewModel">
          <Border Classes="MptCard" Margin="0,0,0,8">
            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Classes="MptMeta" Text="{Binding EditorType}" />
              </Grid>
              <TextBlock Classes="MptPageSubtitle" Text="{Binding Description}" />
              <TextBlock Classes="MptMeta"
                         Text="{Binding DirtySummary}"
                         IsVisible="{Binding IsDirty}" />
              <TextBlock Classes="MptMeta"
                         Text="{Binding ValidationMessage}"
                         IsVisible="{Binding HasValidationError}" />
              <TextBox Text="{Binding Value, Mode=TwoWay}"
                       MinWidth="360"
                       MinHeight="34"
                       IsVisible="{Binding IsSingleLineTextEditor}" />
              <TextBox Text="{Binding Value, Mode=TwoWay}"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       FontFamily="Consolas"
                       FontSize="{DynamicResource MptFontSizeMeta}"
                       MinHeight="120"
                       IsVisible="{Binding IsMultilineEditor}" />
              <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                        Content="{Binding Key}"
                        MinHeight="32"
                        IsVisible="{Binding IsBooleanEditor}" />
              <ComboBox ItemsSource="{Binding Options}"
                        SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                        MinWidth="260"
                        MinHeight="34"
                        IsVisible="{Binding IsEnumEditor}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="MptCard" IsVisible="{Binding UsesRawJson}">
      <StackPanel Spacing="{DynamicResource MptSpacingS}">
        <TextBlock Classes="MptSectionTitle" Text="Raw Settings" />
        <TextBox Text="{Binding RawJson, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="{DynamicResource MptFontSizeMeta}"
                 MinHeight="280" />
      </StackPanel>
    </Border>

    <Button Content="Save settings"
            Command="{Binding SaveCommand}"
            MinHeight="34"
            MinWidth="120" />
  </StackPanel>
</UserControl>
