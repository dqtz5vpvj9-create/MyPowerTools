<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.SettingsCenterView"
             x:DataType="vm:SettingsCenterViewModel">
  <StackPanel Margin="{DynamicResource MptPagePadding}"
              Spacing="{DynamicResource MptSpacingM}">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptPageTitle" Text="{Binding Title}" />
        <TextBlock Classes="MptPageSubtitle" Text="{Binding Subtitle}" />
      </StackPanel>
      <Border Grid.Column="1" Classes="MptStatusBadge">
        <TextBlock Classes="MptMeta" Text="{Binding ChangeSummary}" />
      </Border>
    </Grid>

    <Border Classes="MptSettingsSection">
      <StackPanel Spacing="{DynamicResource MptSpacingS}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="{DynamicResource MptSpacingXs}">
            <TextBlock Classes="MptSectionTitle" Text="Module" />
            <TextBlock Classes="MptMeta"
                       Text="Module configuration is maintained from System &amp; Maintenance."
                       TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="MptMeta" Text="{Binding StatusText}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Modules}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModulePickerItemViewModel">
              <controls:MptButton Command="{Binding SelectCommand}"
                                  MinHeight="{DynamicResource MptDensityCompactControlHeight}"
                                  Margin="{DynamicResource MptWrapItemMargin}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MptSpacingXs}">
                  <TextBlock Text="{Binding DisplayName}" />
                  <TextBlock Classes="MptMeta"
                             Text="{Binding SelectionText}"
                             IsVisible="{Binding IsSelected}" />
                </StackPanel>
              </controls:MptButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="MptPageSubtitle"
                   Text="No modules."
                   IsVisible="{Binding HasNoModules}" />
      </StackPanel>
    </Border>

    <Border Classes="MptSettingsSection" IsVisible="{Binding HasHotkeys}">
      <StackPanel Spacing="8">
        <TextBlock Classes="MptSectionTitle" Text="Keyboard shortcuts" />
        <TextBlock Text="Manage this module together with all application and tool actions in the shortcut center." TextWrapping="Wrap" />
        <controls:MptButton Content="Open keyboard shortcuts" Command="{Binding OpenShortcutsCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <Border Classes="MptSettingsSection">
      <StackPanel Spacing="{DynamicResource MptSpacingS}">
        <TextBlock Classes="MptSectionTitle" Text="Configuration" />
        <TextBlock Classes="MptMeta"
                   Text="{Binding ValidationMessage}"
                   IsVisible="{Binding HasValidationErrors}" />
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsFieldViewModel">
              <Border Classes="MptSettingsField" Margin="{DynamicResource MptGapBottomM}">
                <Grid ColumnDefinitions="260,*" ColumnSpacing="{DynamicResource MptSpacingM}">
                  <StackPanel Spacing="{DynamicResource MptSpacingXs}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                    <TextBlock Classes="MptPageSubtitle" Text="{Binding Description}" TextWrapping="Wrap" />
                    <TextBlock Classes="MptMeta" Text="{Binding EditorType}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="{DynamicResource MptSpacingXs}">
                    <controls:MptTextBox Text="{Binding Value, Mode=TwoWay}"
                                         IsEnabled="{Binding IsEditable}"
                                         IsVisible="{Binding IsSingleLineTextEditor}" />
                    <controls:MptTextBox Text="{Binding Value, Mode=TwoWay}"
                                         IsEnabled="{Binding IsEditable}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="{DynamicResource MptFontFamilyMono}"
                                         FontSize="{DynamicResource MptFontSizeMeta}"
                                         MinHeight="120"
                                         IsVisible="{Binding IsMultilineEditor}" />
                    <controls:MptCheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEditable}"
                                          Content="{Binding Key}"
                                          IsVisible="{Binding IsBooleanEditor}" />
                    <controls:MptComboBox ItemsSource="{Binding Options}"
                                          IsEnabled="{Binding IsEditable}"
                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                          MinWidth="{DynamicResource MptPackageIdInputWidth}"
                                          IsVisible="{Binding IsEnumEditor}" />
                    <TextBlock Classes="MptMeta"
                               Text="{Binding ConstraintSummary}"
                               IsVisible="{Binding HasConstraintSummary}" />
                    <TextBlock Classes="MptMeta"
                               Text="{Binding DirtySummary}"
                               IsVisible="{Binding IsDirty}" />
                    <TextBlock Classes="MptMeta"
                               Text="{Binding ValidationMessage}"
                               IsVisible="{Binding HasValidationError}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="MptInset" IsVisible="{Binding UsesRawJson}">
          <StackPanel Spacing="{DynamicResource MptSpacingS}">
            <TextBlock Classes="MptSectionTitle" Text="Advanced JSON" />
            <TextBlock Classes="MptMeta"
                       Text="Use this editor only when the module does not provide structured settings fields."
                       TextWrapping="Wrap" />
            <controls:MptTextBox Text="{Binding RawJson, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="{DynamicResource MptFontFamilyMono}"
                                 FontSize="{DynamicResource MptFontSizeMeta}"
                                 MinHeight="280" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Classes="MptSettingsSection" IsVisible="{Binding HasSaveResult}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock FontWeight="SemiBold" Text="{Binding SaveResultTitle}" />
          <TextBlock Grid.Column="1" Classes="MptMeta" Text="{Binding SaveResultState}" />
        </Grid>
        <TextBlock Classes="MptMeta" Text="{Binding SaveResultMessage}" TextWrapping="Wrap" />
        <TextBlock Classes="MptMeta"
                   Text="{Binding SaveResultRevision}"
                   IsVisible="{Binding HasSaveResultRevision}" />
      </StackPanel>
    </Border>

    <Border Classes="MptStickyFooter">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
        <StackPanel Spacing="{DynamicResource MptSpacingXs}">
          <TextBlock FontWeight="SemiBold" Text="{Binding ChangeSummary}" />
          <TextBlock Classes="MptMeta"
                     Text="{Binding PatchPreview}"
                     IsVisible="{Binding HasPatchPreview}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <controls:MptButton Grid.Column="1"
                            Classes="MptPrimaryButton"
                            Content="Save module settings"
                            Command="{Binding SaveCommand}"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
