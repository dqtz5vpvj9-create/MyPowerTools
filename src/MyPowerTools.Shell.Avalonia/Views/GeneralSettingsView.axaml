<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">
  <StackPanel x:Name="GeneralRoot"
              MaxWidth="{DynamicResource MptLayoutSettingsMaxWidth}"
              HorizontalAlignment="Center"
              Spacing="{DynamicResource MptSpacingXl}">
    <StackPanel Spacing="{DynamicResource MptSpacingXs}">
      <TextBlock Classes="MptPageTitle" Text="{Binding Title}" />
      <TextBlock Classes="MptPageSubtitle" Text="{Binding Subtitle}" />
    </StackPanel>

    <Border Classes="MptSettingsSection">
      <Grid x:Name="AppearanceLayoutGrid"
            ColumnDefinitions="*,320"
            RowDefinitions="Auto"
            ColumnSpacing="{DynamicResource MptSpacing2Xl}">
        <StackPanel Spacing="{DynamicResource MptSpacingS}">
          <TextBlock Classes="MptSectionTitle" Text="Appearance" />
          <TextBlock Classes="MptPageSubtitle"
                     Text="Choose the application theme used across MyPowerTools."
                     MaxWidth="520"
                     HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel x:Name="ThemeControlPanel"
                    Grid.Column="1"
                    Spacing="{DynamicResource MptSpacingS}">
          <TextBlock FontWeight="SemiBold" Text="App theme" />
          <controls:MptComboBox ItemsSource="{Binding Themes}"
                                SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                HorizontalAlignment="Stretch">
            <controls:MptComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ThemeChoiceViewModel">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </controls:MptComboBox.ItemTemplate>
          </controls:MptComboBox>
          <TextBlock Classes="MptMeta"
                     Text="{Binding ThemeSummary}"
                     TextWrapping="Wrap" />
          <TextBlock Classes="MptMeta"
                     Text="{Binding ThemeApplyStatus}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="SecondarySettingsGrid"
          ColumnDefinitions="*,*"
          RowDefinitions="Auto"
          ColumnSpacing="{DynamicResource MptSpacingL}">
      <Border Classes="MptSettingsSection">
        <StackPanel Spacing="{DynamicResource MptSpacingL}">
          <StackPanel Spacing="{DynamicResource MptSpacingXs}">
            <TextBlock Classes="MptSectionTitle" Text="Background operation" />
            <TextBlock Classes="MptPageSubtitle"
                       Text="How the application remains available after its window closes." />
          </StackPanel>

          <Border BorderBrush="{DynamicResource MptBrushDivider}"
                  BorderThickness="0,1,0,0"
                  Padding="{DynamicResource MptListItemPadding}">
            <Grid ColumnDefinitions="40,*,Auto"
                  ColumnSpacing="{DynamicResource MptSpacingM}">
              <TextBlock Text="&#xE7E7;"
                         FontFamily="{DynamicResource MptFontFamilyIcons}"
                         FontSize="{DynamicResource MptFontSizeSection}"
                         Foreground="{DynamicResource MptBrushTextSecondary}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="1"
                          Spacing="{DynamicResource MptSpacingXs}">
                <TextBlock FontWeight="SemiBold" Text="Notification area" />
                <TextBlock Classes="MptMeta"
                           Text="Use the tray menu to open or exit MyPowerTools."
                           TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="2"
                         Classes="MptMeta"
                         Text="Available while running"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="KeyboardSettingsCard" Grid.Column="1" Classes="MptSettingsSection">
        <StackPanel Spacing="12">
          <TextBlock Classes="MptSectionTitle" Text="Keyboard shortcuts" />
          <TextBlock Text="Manage background, application and tool shortcuts in one place. Changes apply without restarting."
                     TextWrapping="Wrap" Classes="MptMeta" />
          <controls:MptButton Content="Open keyboard shortcuts" Command="{Binding OpenShortcutsCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </Grid>

   <Border Classes="MptSettingsSection">
      <Grid ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto,Auto,Auto"
            RowSpacing="{DynamicResource MptSpacingS}"
            ColumnSpacing="{DynamicResource MptSpacingL}"
            IsVisible="{Binding !!DevSource}">
        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Spacing="{DynamicResource MptSpacingXs}">
          <TextBlock Classes="MptSectionTitle" Text="Developer sources" />
          <TextBlock Classes="MptPageSubtitle"
                     Text="Sync build outputs from local source folders into the installed module directory on every tool refresh."
                     TextWrapping="Wrap"
                     MaxWidth="720"
                     HorizontalAlignment="Left" />
        </StackPanel>

        <Grid Grid.Row="1"
              Grid.ColumnSpan="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="{DynamicResource MptSpacingL}">
          <Border Classes="MptSettingsField">
            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock FontWeight="SemiBold" Text="Enable source sync" />
              <TextBlock Classes="MptMeta"
                         Text="When on, configured folders are checked on every dotnet-surface tool refresh."
                         TextWrapping="Wrap" />
              <controls:MptCheckBox Content="Enable developer source sync"
                        IsChecked="{Binding DevSource.Enabled, Mode=TwoWay}"
                        Margin="{DynamicResource MptGapTopXs}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1"
                  Classes="MptSettingsField">
            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock FontWeight="SemiBold" Text="Sync on refresh" />
              <TextBlock Classes="MptMeta"
                         Text="Keep this on to pull latest files each time you click a tool's refresh button."
                         TextWrapping="Wrap" />
              <controls:MptCheckBox Content="Sync from developer sources when refreshing tools"
                        IsChecked="{Binding DevSource.SyncOnRefresh, Mode=TwoWay}"
                        Margin="{DynamicResource MptGapTopXs}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Classes="MptSettingsField">
          <StackPanel Spacing="{DynamicResource MptSpacingS}">
            <TextBlock FontWeight="SemiBold" Text="Add a source mapping" />
           <Grid ColumnDefinitions="*,*,*,Auto"
                 ColumnSpacing="{DynamicResource MptSpacingS}">
            <controls:MptTextBox PlaceholderText="Name (optional)"
                     Text="{Binding DevSource.NewName, Mode=TwoWay}" />
            <controls:MptTextBox Grid.Column="1"
                     PlaceholderText="Tool id (optional, e.g. remote-notifications)"
                     Text="{Binding DevSource.NewToolId, Mode=TwoWay}" />
              <controls:MptButton Grid.Column="2"
                                Content="Add"
                                Command="{Binding DevSource.AddMappingCommand}"
                                VerticalAlignment="Bottom" />
           </Grid>
            <controls:MptTextBox PlaceholderText="Source directory (build output, e.g. ...\bin\Release\net10.0)"
                     Text="{Binding DevSource.NewSourceDir, Mode=TwoWay}" />
            <controls:MptTextBox PlaceholderText="Target directory (installed module path)"
                     Text="{Binding DevSource.NewTargetDir, Mode=TwoWay}" />
            <controls:MptTextBox PlaceholderText="File patterns (comma-separated), e.g. *.dll,*.pdb,*.deps.json"
                     Text="{Binding DevSource.NewPatterns, Mode=TwoWay}" />
          </StackPanel>
        </Border>

        <ItemsControl Grid.Row="3"
                      Grid.ColumnSpan="2"
                      ItemsSource="{Binding DevSource.Mappings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DevSourceMappingViewModel">
              <Border Classes="MptSettingsField"
                      Margin="{DynamicResource MptGapBottomXs}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="{DynamicResource MptSpacingM}">
                  <StackPanel Spacing="{DynamicResource MptSpacing2Xs}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock Classes="MptMeta" Text="{Binding SourceDir}" TextWrapping="Wrap" />
                    <TextBlock Classes="MptMeta" Text="{Binding TargetDir}" TextWrapping="Wrap" />
                    <TextBlock Classes="MptMeta"
                               Text="{Binding ToolId, StringFormat='Tool: {0}'}"
                               IsVisible="{Binding !!ToolId}" />
                    <TextBlock Classes="MptMeta"
                               Text="{Binding Patterns, StringFormat='Patterns: {0}'}" />
                </StackPanel>
                <controls:MptButton Grid.Column="1"
                                  Content="Remove"
                                  Command="{Binding RemoveCommand}"
                                  VerticalAlignment="Top" />
                </Grid>
              </Border>
            </DataTemplate>
              </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Border Classes="MptSettingsSection">
      <Grid x:Name="MaintenanceGrid"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto"
            ColumnSpacing="{DynamicResource MptSpacingL}">
        <StackPanel Spacing="{DynamicResource MptSpacingXs}">
          <TextBlock Classes="MptCardTitle" Text="System &amp; Maintenance" />
          <TextBlock Classes="MptMeta"
                     Text="Manage runtime modules, packages, logs, and support diagnostics in one place."
                     TextWrapping="Wrap" />
        </StackPanel>
        <controls:MptButton x:Name="OpenSystemButton"
                            Grid.Column="1"
                            Content="Open System"
                            Command="{Binding OpenSystemCommand}"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}"
                            VerticalAlignment="Center" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
