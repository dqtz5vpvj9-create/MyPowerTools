<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             xmlns:views="using:MyPowerTools.Shell.Avalonia.Views"
             x:Class="MyPowerTools.Shell.Avalonia.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <UserControl.Resources>
    <views:BoolToTextWrappingConverter x:Key="BoolToTextWrapping" />
  </UserControl.Resources>
  <StackPanel Margin="{DynamicResource MptPagePadding}" Spacing="{DynamicResource MptSpacingM}">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptPageTitle" Text="{Binding Title}" />
        <TextBlock Classes="MptPageSubtitle" Text="{Binding Subtitle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Classes="MptActionBar" Orientation="Horizontal">
        <controls:MptButton Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
        <controls:MptButton Content="Copy"
                            Click="OnCopyClicked"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
        <controls:MptButton Content="Export"
                            Command="{Binding ExportCommand}"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
      </StackPanel>
    </Grid>

    <Border IsVisible="{Binding HasError}"
            Classes="MptErrorView"
            Padding="{DynamicResource MptCardPadding}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptSectionTitle" Text="日志源不可用" />
        <TextBlock Classes="MptPageSubtitle" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Classes="MptToolbar">
      <StackPanel Classes="MptToolbar" Orientation="Horizontal">
        <controls:MptTextBox PlaceholderText="Search logs"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             MinWidth="{DynamicResource MptPackageIdInputWidth}" />
        <controls:MptButton Content="{Binding AllLabel}"
                            Command="{Binding AllCommand}"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
        <controls:MptButton Content="{Binding InfoLabel}"
                            Command="{Binding InfoCommand}"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
        <controls:MptButton Content="{Binding WarningLabel}"
                            Command="{Binding WarningCommand}"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
        <controls:MptButton Content="{Binding ErrorLabel}"
                            Command="{Binding ErrorCommand}"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
        <controls:MptButton Content="{Binding WrapText}"
                            Command="{Binding ToggleWrapCommand}"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
      </StackPanel>
    </Border>

    <TextBlock Classes="MptMeta"
               Text="{Binding FilterSummary}"
               IsVisible="{Binding HasNoModules}" />
    <TextBlock Classes="MptMeta"
               Text="{Binding ActionStatus}"
               IsVisible="{Binding HasActionStatus}"
               TextWrapping="Wrap" />

    <Border Classes="MptSettingsSection">
      <StackPanel Spacing="{DynamicResource MptSpacingS}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="MptSectionTitle" Text="Modules" />
          <TextBlock Grid.Column="1" Classes="MptMeta" Text="{Binding FilterSummary}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Modules}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModulePickerItemViewModel">
              <controls:MptButton Command="{Binding SelectCommand}"
                                  MinHeight="{DynamicResource MptDensityCompactControlHeight}"
                                  Margin="{DynamicResource MptWrapItemMargin}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MptSpacingXs}">
                  <TextBlock Text="{Binding DisplayName}" />
                  <TextBlock Classes="MptMeta" Text="{Binding SelectionText}" IsVisible="{Binding IsSelected}" />
                </StackPanel>
              </controls:MptButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="MptPageSubtitle"
                   Text="No modules."
                   IsVisible="{Binding HasNoModules}" />
      </StackPanel>
    </Border>

    <Border Classes="MptLogViewer">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <StackPanel IsVisible="{Binding HasNoLogs}" Spacing="{DynamicResource MptSpacingXs}">
          <TextBlock Classes="MptPageSubtitle" Text="No logs match the current filter." />
          <TextBlock Classes="MptMeta" Text="Try clearing the search text or switching the level filter." />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Lines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLineViewModel">
              <Border Classes="MptLogRow" Margin="{DynamicResource MptGapBottomXs}">
                <Grid ColumnDefinitions="128,84,72,*" ColumnSpacing="{DynamicResource MptSpacingS}">
                  <TextBlock Classes="MptMeta" Text="{Binding Time}" />
                  <Border Grid.Column="1" Classes="MptStatusBadge">
                    <TextBlock Classes="MptMeta" Text="{Binding Level}" />
                  </Border>
                  <TextBlock Grid.Column="2" Classes="MptMeta" Text="{Binding ModuleId}" />
                  <TextBlock Grid.Column="3"
                             FontFamily="{DynamicResource MptFontFamilyMono}"
                             FontSize="{DynamicResource MptFontSizeMeta}"
                             Text="{Binding Message}"
                             TextWrapping="{Binding $parent[UserControl].DataContext.WrapLines, Converter={StaticResource BoolToTextWrapping}}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
