<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <UserControl.Styles>
    <Style Selector="Border.PowerDashboardCard">
      <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
      <Setter Property="BoxShadow" Value="{DynamicResource MptShadowCard}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.MptHomeTile">
      <Setter Property="Width" Value="{DynamicResource MptHomeTileWidth}" />
    </Style>
    <Style Selector="Border.PowerStatusIcon">
      <Setter Property="Width" Value="{DynamicResource MptToolIconSizeLarge}" />
      <Setter Property="Height" Value="{DynamicResource MptToolIconSizeLarge}" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusIconTileLarge}" />
      <Setter Property="Padding" Value="{DynamicResource MptToolIconPaddingLarge}" />
      <Setter Property="Background" Value="{DynamicResource MptBrushSuccessBackground}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.PowerStatusIcon > Path">
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="{DynamicResource MptIconStroke}" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stroke" Value="{DynamicResource MptBrushSuccess}" />
      <Setter Property="Data" Value="{DynamicResource MptIconGeoCheckCircle}" />
    </Style>
    <Style Selector="Border.PowerStatusIcon.warning">
      <Setter Property="Background" Value="{DynamicResource MptBrushWarningBackground}" />
    </Style>
    <Style Selector="Border.PowerStatusIcon.warning > Path">
      <Setter Property="Stroke" Value="{DynamicResource MptBrushWarning}" />
      <Setter Property="Data" Value="{DynamicResource MptIconGeoAlert}" />
    </Style>
    <Style Selector="TextBlock.PowerStatValue">
      <Setter Property="FontSize" Value="{DynamicResource MptFontSizeStat}" />
      <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightStat}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.PowerStatValue.success">
      <Setter Property="Foreground" Value="{DynamicResource MptBrushSuccess}" />
    </Style>
    <Style Selector="TextBlock.PowerStatValue.warning">
      <Setter Property="Foreground" Value="{DynamicResource MptBrushWarning}" />
    </Style>
    <Style Selector="TextBlock.PowerStatLabel">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.PowerAttentionRow">
      <Setter Property="Padding" Value="{DynamicResource MptAttentionRowPadding}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushDivider}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <x:Double x:Key="MptHomeTileWidth">220</x:Double>

    <DataTemplate x:Key="ToolTileTemplate" x:DataType="vm:ToolCardViewModel">
      <controls:MptButton Classes="MptHomeTile"
                          Command="{Binding OpenCommand}"
                          IsEnabled="{Binding CanOpen}"
                          ToolTip.Tip="{Binding Description}"
                          AutomationProperties.Name="{Binding OpenAutomationName}">
        <Grid RowDefinitions="Auto,Auto,*,Auto"
              RowSpacing="{DynamicResource MptSpacingXs}">
          <Grid ColumnDefinitions="Auto,*"
                Margin="{DynamicResource MptGapBottomXs}">
            <controls:MptToolIcon Classes="small"
                                  IconKey="{Binding ToolId}" />
          </Grid>
          <TextBlock Grid.Row="1"
                     Text="{Binding Title}"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="2"
                     Classes="MptMeta"
                     Text="{Binding Description}"
                     TextWrapping="Wrap"
                     MaxLines="2"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="3"
                     Classes="MptMeta"
                     Text="{Binding StatusLabel}"
                     IsVisible="{Binding !CanOpen}"
                     Foreground="{DynamicResource MptBrushTextMuted}" />
        </Grid>
      </controls:MptButton>
    </DataTemplate>

    <DataTemplate x:Key="AttentionTemplate" x:DataType="vm:ToolCardViewModel">
      <Border Classes="PowerAttentionRow">
        <Grid ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="{DynamicResource MptSpacingM}">
          <controls:MptToolIcon Classes="small"
                                IconKey="{Binding ToolId}" />
          <StackPanel Grid.Column="1"
                      Spacing="{DynamicResource MptSpacing2Xs}"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="MptMeta"
                       Text="{Binding StatusHint}"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Border Grid.Column="2"
                  Classes="MptStatusBadge"
                  Classes.degraded="{Binding IsAvailable}"
                  Classes.error="{Binding IsUnavailable}"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusLabel}" />
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel x:Name="DashboardRoot"
              MaxWidth="{DynamicResource MptLayoutDashboardMaxWidth}"
              HorizontalAlignment="Center"
              Spacing="{DynamicResource MptSpacingXl}">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="{DynamicResource MptSpacingM}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptPageTitle"
                   Text="{Binding Greeting}" />
        <TextBlock Classes="MptPageSubtitle"
                   Text="{Binding Subtitle}" />
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="{DynamicResource MptSpacingS}"
                  VerticalAlignment="Center">
        <controls:MptButton Classes="MptIconOnlyButton outlined"
                            Command="{Binding RefreshCommand}"
                            ToolTip.Tip="Refresh"
                            AutomationProperties.Name="Refresh">
          <Path Classes="MptInlineIcon"
                Data="{DynamicResource MptIconGeoRefresh}" />
        </controls:MptButton>
        <controls:MptButton Classes="MptPrimaryButton"
                            Content="Browse tools"
                            Command="{Binding BrowseToolsCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel IsVisible="{Binding IsLoading}"
                Spacing="{DynamicResource MptSpacingM}">
      <Border Classes="MptLoadingSkeleton" Height="96" />
      <Border Classes="MptLoadingSkeleton" Height="240" />
    </StackPanel>

    <Border Classes="MptErrorState"
            IsVisible="{Binding IsFailed}">
      <StackPanel Spacing="{DynamicResource MptSpacingM}">
        <TextBlock Classes="MptCardTitle"
                   Text="Home couldn't be loaded" />
        <TextBlock Classes="MptPageSubtitle"
                   Text="{Binding ErrorMessage}" />
        <controls:MptButton Classes="MptPrimaryButton"
                            Content="Try again"
                            Command="{Binding RetryCommand}"
                            HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <Border Classes="MptEmptyState"
            IsVisible="{Binding IsEmpty}">
      <StackPanel Spacing="{DynamicResource MptSpacingM}"
                  HorizontalAlignment="Center"
                  MaxWidth="520">
        <controls:MptToolIcon Classes="large"
                              IconKey="toolkit"
                              HorizontalAlignment="Center" />
        <TextBlock Classes="MptCardTitle"
                   Text="No tools yet"
                   HorizontalAlignment="Center" />
        <TextBlock Classes="MptPageSubtitle"
                   Text="Tools you install will show up here."
                   TextAlignment="Center" />
        <controls:MptButton Classes="MptPrimaryButton"
                            Content="Browse tools"
                            Command="{Binding BrowseToolsCommand}"
                            HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <StackPanel IsVisible="{Binding IsReady}"
                Spacing="{DynamicResource MptSpacingXl}">
      <!-- Health summary -->
      <Border Classes="PowerDashboardCard"
              Padding="{DynamicResource MptCardPaddingLarge}">
        <Grid x:Name="OverviewGrid"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto">
          <Grid ColumnDefinitions="Auto,*"
                ColumnSpacing="{DynamicResource MptSpacingL}">
            <Border Classes="PowerStatusIcon"
                    Classes.warning="{Binding DashboardHasWarning}">
              <Path />
            </Border>
            <StackPanel Grid.Column="1"
                        Spacing="{DynamicResource MptSpacing2Xs}"
                        VerticalAlignment="Center">
              <TextBlock Classes="MptCardTitle"
                         Text="{Binding DashboardStatusLabel}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="MptMeta"
                         Text="{Binding DashboardStatusDetail}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>

          <Grid x:Name="OverviewStatus"
                Grid.Column="1"
                ColumnDefinitions="Auto,Auto,Auto"
                ColumnSpacing="{DynamicResource MptSpacing2Xl}"
                Margin="{DynamicResource MptGapLeft2Xl}"
                VerticalAlignment="Center">
            <StackPanel>
              <TextBlock Classes="PowerStatValue" Text="{Binding TotalToolCount}" />
              <TextBlock Classes="MptMeta PowerStatLabel" Text="Installed" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="PowerStatValue success" Text="{Binding ReadyToolCount}" />
              <TextBlock Classes="MptMeta PowerStatLabel" Text="Ready" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="PowerStatValue"
                         Classes.warning="{Binding DashboardHasWarning}"
                         Text="{Binding NeedsAttentionCount}" />
              <TextBlock Classes="MptMeta PowerStatLabel" Text="Need attention" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid x:Name="DashboardColumns"
            ColumnDefinitions="5*,3*"
            RowDefinitions="Auto"
            ColumnSpacing="{DynamicResource MptSpacingL}">
        <!-- Favorites and recent tools -->
        <StackPanel x:Name="PrimaryDashboardColumn"
                    Grid.Column="0"
                    Spacing="{DynamicResource MptSpacingM}"
                    HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="MptSectionTitle"
                       Text="{Binding DashboardToolsTitle}"
                       VerticalAlignment="Center" />
            <controls:MptButton Grid.Column="1"
                                Classes="MptLinkButton"
                                Content="View all"
                                Command="{Binding BrowseToolsCommand}"
                                VerticalAlignment="Center" />
          </Grid>
          <ItemsControl ItemsSource="{Binding DashboardTools}"
                        ItemTemplate="{StaticResource ToolTileTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- Attention -->
        <Border x:Name="ModulesDashboardCard"
                Grid.Column="1"
                Classes="PowerDashboardCard"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Classes="MptCardTitle"
                       Text="Needs attention"
                       Margin="{DynamicResource MptAttentionHeaderMargin}" />
            <ItemsControl ItemsSource="{Binding AttentionTools}"
                          ItemTemplate="{StaticResource AttentionTemplate}"
                          IsVisible="{Binding HasAttentionTools}" />
            <StackPanel IsVisible="{Binding !HasAttentionTools}"
                        Spacing="{DynamicResource MptSpacingS}"
                        Margin="{DynamicResource MptCardPaddingLarge}"
                        HorizontalAlignment="Center">
              <Border Classes="PowerStatusIcon"
                      HorizontalAlignment="Center">
                <Path />
              </Border>
              <TextBlock Text="Everything is running smoothly"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Classes="MptMeta"
                         Text="Problems with your tools will show up here."
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
