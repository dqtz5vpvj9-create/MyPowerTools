<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.SystemHubView"
             x:DataType="vm:SystemHubViewModel">
  <UserControl.Styles>
    <Style Selector="Border.MptSettingsListRow">
      <Setter Property="MinHeight" Value="76" />
      <Setter Property="Padding" Value="{DynamicResource MptSettingsRowPadding}" />
      <Setter Property="Margin" Value="{DynamicResource MptGapBottomS}" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
      <Setter Property="Background" Value="{DynamicResource MptBrushLayerBackground}" />
    </Style>
    <Style Selector="Border.MptSettingsListRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource MptBrushLayerAltBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
    </Style>
    <Style Selector="controls|MptButton.MptCompactIconButton">
      <Setter Property="MinWidth" Value="{DynamicResource MptDensityControlHeight}" />
      <Setter Property="Width" Value="{DynamicResource MptDensityControlHeight}" />
      <Setter Property="Padding" Value="{DynamicResource MptNoThickness}" />
      <Setter Property="FontSize" Value="{DynamicResource MptFontSizeCardTitle}" />
    </Style>
    <Style Selector="TextBlock.MptChevron">
      <Setter Property="FontSize" Value="{DynamicResource MptFontSizeSection}" />
      <Setter Property="Foreground" Value="{DynamicResource MptBrushTextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <StackPanel MaxWidth="{DynamicResource MptLayoutPageMaxWidth}"
              HorizontalAlignment="Stretch"
              Spacing="{DynamicResource MptSpacingL}">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="{DynamicResource MptSpacingM}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptPageTitle"
                   Text="{Binding Title}" />
        <TextBlock Classes="MptPageSubtitle"
                   Text="{Binding Subtitle}" />
      </StackPanel>
      <controls:MptButton Grid.Column="1"
                          Classes="MptCompactIconButton"
                          Content="↻"
                          Command="{Binding RefreshCommand}"
                          ToolTip.Tip="Refresh system status"
                          VerticalAlignment="Top" />
    </Grid>

    <StackPanel IsVisible="{Binding IsLoading}"
                Spacing="{DynamicResource MptSpacingS}">
      <TextBlock Classes="MptMeta"
                 Text="Loading maintenance destinations…" />
      <Border Classes="MptLoadingSkeleton" Height="76" />
      <Border Classes="MptLoadingSkeleton" Height="76" />
      <Border Classes="MptLoadingSkeleton" Height="76" />
    </StackPanel>

    <Border Classes="MptErrorState"
            IsVisible="{Binding IsFailed}">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="{DynamicResource MptSpacingM}">
        <StackPanel Spacing="{DynamicResource MptSpacingXs}">
          <TextBlock Classes="MptCardTitle"
                     Text="Maintenance pages could not be loaded" />
          <TextBlock Classes="MptPageSubtitle"
                     Text="{Binding ErrorMessage}" />
        </StackPanel>
        <controls:MptButton Grid.Column="1"
                            Classes="MptPrimaryButton"
                            Content="Try again"
                            Command="{Binding RetryCommand}"
                            VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Classes="MptEmptyState"
            IsVisible="{Binding IsEmpty}">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="{DynamicResource MptSpacingM}">
        <StackPanel Spacing="{DynamicResource MptSpacingXs}">
          <TextBlock Classes="MptCardTitle"
                     Text="No maintenance pages are available" />
          <TextBlock Classes="MptPageSubtitle"
                     Text="Refresh after runtime maintenance destinations are registered." />
        </StackPanel>
        <controls:MptButton Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            VerticalAlignment="Center" />
      </Grid>
    </Border>

    <StackPanel IsVisible="{Binding IsReady}"
                Spacing="{DynamicResource MptSpacingS}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}"
                  Margin="{DynamicResource MptGapBottomXs}">
        <TextBlock Classes="MptSectionTitle"
                   Text="System destinations" />
        <TextBlock Classes="MptMeta"
                   Text="Runtime, packages, logs, and support diagnostics" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Destinations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SystemHubItemViewModel">
            <Border Classes="MptSettingsListRow">
              <Grid ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="{DynamicResource MptSpacingM}">
                <Border Classes="MptToolIcon"
                        VerticalAlignment="Center">
                  <TextBlock Classes="MptToolIconGlyph"
                             Text="{Binding IconGlyph}" />
                </Border>

                <StackPanel Grid.Column="1"
                            Spacing="{DynamicResource MptSpacingXs}"
                            VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal"
                              Spacing="{DynamicResource MptSpacingS}">
                    <TextBlock Classes="MptCardTitle"
                               Text="{Binding Title}" />
                    <Border Classes="MptStatusBadge"
                            VerticalAlignment="Center">
                      <TextBlock Classes="MptMeta"
                                 Text="{Binding StatusLabel}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="MptPageSubtitle"
                             Text="{Binding Description}"
                             MaxLines="2" />
                </StackPanel>

                <controls:MptButton Grid.Column="2"
                                    Classes="MptCompactIconButton"
                                    Command="{Binding OpenCommand}"
                                    ToolTip.Tip="{Binding OpenActionLabel}"
                                    VerticalAlignment="Center">
                  <TextBlock Classes="MptChevron"
                             Text="›" />
                </controls:MptButton>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
