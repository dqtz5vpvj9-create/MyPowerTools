<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:adaptive="using:MyPowerTools.AvaloniaSdk"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.SystemHubView"
             x:DataType="vm:SystemHubViewModel">
  <UserControl.Styles>
    <Style Selector="Button.MptHubRow">
      <Setter Property="Padding" Value="{DynamicResource MptToolRowPadding}" />
      <Setter Property="Margin" Value="{DynamicResource MptGapBottomS}" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
      <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.MptHubRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccent}" />
    </Style>
  </UserControl.Styles>

  <StackPanel MaxWidth="{DynamicResource MptLayoutSettingsMaxWidth}"
              HorizontalAlignment="Stretch"
              Spacing="{DynamicResource MptSpacingL}">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="{DynamicResource MptSpacingM}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptPageTitle"
                   Text="{Binding Title}" />
        <TextBlock Classes="MptPageSubtitle"
                   Text="{Binding Subtitle}" />
      </StackPanel>
      <controls:MptButton Grid.Column="1"
                          Classes="MptIconOnlyButton outlined"
                          Command="{Binding RefreshCommand}"
                          ToolTip.Tip="Refresh"
                          AutomationProperties.Name="Refresh"
                          VerticalAlignment="Top">
        <Path Classes="MptInlineIcon"
              Data="{DynamicResource MptIconGeoRefresh}" />
      </controls:MptButton>
    </Grid>

    <StackPanel IsVisible="{Binding IsLoading}"
                Spacing="{DynamicResource MptSpacingS}">
      <Border Classes="MptLoadingSkeleton" Height="72" />
      <Border Classes="MptLoadingSkeleton" Height="72" />
      <Border Classes="MptLoadingSkeleton" Height="72" />
    </StackPanel>


    <Border Classes="MptEmptyState"
            IsVisible="{Binding IsEmpty}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptCardTitle"
                   Text="Nothing to show" />
        <TextBlock Classes="MptPageSubtitle"
                   Text="There are no troubleshooting tools right now." />
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Destinations}"
                  IsVisible="{Binding IsReady}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SystemHubItemViewModel">
          <controls:MptButton Classes="MptHubRow"
                              Command="{Binding OpenCommand}"
                              AutomationProperties.Name="{Binding OpenActionLabel}">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="{DynamicResource MptSpacingL}">
              <controls:MptToolIcon IconKey="{Binding IconGlyph}" />
              <StackPanel Grid.Column="1"
                          Spacing="{DynamicResource MptSpacing2Xs}"
                          VerticalAlignment="Center">
                <TextBlock Classes="MptCardTitle"
                           Text="{Binding Title}" />
                <TextBlock Classes="MptMeta"
                           Text="{Binding Description}"
                           TextWrapping="Wrap"
                           MaxLines="2" />
              </StackPanel>
              <Path Grid.Column="2"
                    Classes="MptChevron" />
            </Grid>
          </controls:MptButton>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
