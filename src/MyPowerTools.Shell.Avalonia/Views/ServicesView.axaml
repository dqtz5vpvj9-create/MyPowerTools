<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.ServicesView"
             x:DataType="vm:ServicesViewModel">
  <UserControl.Styles>
    <Style Selector="Border.ServiceOverview">
      <Setter Property="Padding" Value="20,16" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
      <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
    </Style>
    <Style Selector="Border.ServiceCard">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
      <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.ServiceGlyph">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
      <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceInset}" />
    </Style>
    <Style Selector="Border.ServiceStateBadge">
      <Setter Property="Padding" Value="10,2" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusBadge}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushWarning}" />
      <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.ServiceStateBadge.healthy">
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushSuccess}" />
    </Style>
    <Style Selector="Border.ServiceStateBadge.failed">
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushDanger}" />
    </Style>
    <Style Selector="TextBlock.ServiceMetricValue">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="{DynamicResource MptFontSizeBody}" />
      <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightBody}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="{DynamicResource MptPagePadding}"
              Spacing="{DynamicResource MptSpacingM}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingL}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptPageTitle" Text="{Binding Title}" />
        <TextBlock Classes="MptPageSubtitle" Text="{Binding Subtitle}" />
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="{DynamicResource MptSpacingS}"
                  VerticalAlignment="Center">
        <controls:MptButton Content="Reload manifests"
                            Command="{Binding ReloadManifestsCommand}" />
        <controls:MptButton Classes="MptPrimaryButton"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <Border Classes="MptErrorState"
            Padding="{DynamicResource MptUniformS}"
            IsVisible="{Binding Disconnected}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingS}">
        <StackPanel Orientation="Horizontal"
                    Spacing="{DynamicResource MptSpacingS}"
                    VerticalAlignment="Center">
          <TextBlock Text="&#xEA39;"
                     FontFamily="{DynamicResource MptFontFamilyIcons}"
                     Foreground="{DynamicResource MptBrushDanger}" />
          <TextBlock Classes="MptBody"
                     Text="ServiceManager connection interrupted. The last known state remains visible." />
        </StackPanel>
        <controls:MptButton Grid.Column="1"
                            Content="Reconnect"
                            Command="{Binding RefreshCommand}" />
      </Grid>
    </Border>

    <Border Classes="ServiceOverview">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="{DynamicResource MptSpacingM}">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{DynamicResource MptSpacing2Xl}">
          <StackPanel Spacing="{DynamicResource MptSpacingXs}">
            <TextBlock Classes="MptCardTitle" Text="Service manager" />
            <TextBlock Classes="MptMeta"
                       Text="Services keep their own lifetime while MyPowerTools provides one control surface." />
          </StackPanel>
          <StackPanel Grid.Column="1" MinWidth="72">
            <TextBlock Classes="MptMeta" Text="Services" />
            <TextBlock Classes="ServiceMetricValue" Text="{Binding TotalCount}" />
          </StackPanel>
          <StackPanel Grid.Column="2" MinWidth="72">
            <TextBlock Classes="MptMeta" Text="Running" />
            <TextBlock Classes="ServiceMetricValue"
                       Foreground="{DynamicResource MptBrushSuccess}"
                       Text="{Binding ActiveCount}" />
          </StackPanel>
          <StackPanel Grid.Column="3" MinWidth="72">
            <TextBlock Classes="MptMeta" Text="Attention" />
            <TextBlock Classes="ServiceMetricValue"
                       Foreground="{DynamicResource MptBrushWarning}"
                       Text="{Binding AttentionCount}" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,160,Auto"
              ColumnSpacing="{DynamicResource MptSpacingS}"
              IsVisible="{Binding !HasNoUnits}">
          <controls:MptTextBox Text="{Binding SearchText}"
                               PlaceholderText="Search services or tools" />
          <controls:MptComboBox Grid.Column="1"
                                ItemsSource="{Binding StateFilters}"
                                SelectedItem="{Binding StateFilter}" />
          <TextBlock Grid.Column="2"
                     Classes="MptMeta"
                     Text="{Binding VisibleCount, StringFormat='{}{0} shown'}"
                     VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>

    <Border Classes="MptEmptyState" IsVisible="{Binding HasNoUnits}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptSectionTitle" Text="No services registered" />
        <TextBlock Classes="MptMeta"
                   Text="Deploy a Service Unit manifest, then choose Reload manifests." />
      </StackPanel>
    </Border>

    <Border Classes="MptEmptyState" IsVisible="{Binding HasNoResults}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptSectionTitle" Text="No matching services" />
        <TextBlock Classes="MptMeta" Text="Change the search text or state filter." />
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Units}"
                  IsVisible="{Binding HasVisibleUnits}">
      <ItemsControl.Styles>
        <Style Selector="ContentPresenter">
          <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
      </ItemsControl.Styles>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ServiceUnitViewModel">
          <Border Classes="ServiceCard">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="40,*,Auto,Auto"
                  ColumnSpacing="{DynamicResource MptSpacingM}"
                  RowSpacing="{DynamicResource MptSpacingM}">
              <Border Classes="ServiceGlyph">
                <TextBlock Text="&#xE713;"
                           FontFamily="{DynamicResource MptFontFamilyIcons}"
                           FontSize="{DynamicResource MptFontSizeHeader}"
                           Foreground="{DynamicResource MptBrushAccent}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>

              <StackPanel Grid.Column="1"
                          Spacing="{DynamicResource MptSpacingXs}"
                          VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MptSpacingS}">
                  <TextBlock Classes="MptCardTitle" Text="{Binding DisplayName}" />
                  <TextBlock Classes="MptMeta"
                             Text="{Binding ToolId}"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="MptMeta" Text="{Binding StateSummary}" />
              </StackPanel>

              <Border Grid.Column="2"
                      Classes="ServiceStateBadge"
                      Classes.healthy="{Binding IsHealthy}"
                      Classes.failed="{Binding IsFailed}">
                <TextBlock Classes="MptMeta" Text="{Binding StatusLabel}" />
              </Border>

              <StackPanel Grid.Column="3"
                          Orientation="Horizontal"
                          Spacing="{DynamicResource MptSpacingS}"
                          VerticalAlignment="Center">
                <controls:MptButton Content="Start"
                                    Classes="MptPrimaryButton"
                                    Command="{Binding StartCommand}"
                                    IsVisible="{Binding CanStart}" />
                <controls:MptButton Content="Stop"
                                    Command="{Binding StopCommand}"
                                    IsVisible="{Binding CanStop}" />
                <controls:MptButton Content="Restart"
                                    Command="{Binding RestartCommand}"
                                    IsEnabled="{Binding CanRestart}" />
                <controls:MptButton Content="Logs"
                                    Command="{Binding TailLogsCommand}" />
                <controls:MptButton Content="Open tool"
                                    Classes="MptPrimaryButton"
                                    Command="{Binding OpenToolCommand}" />
              </StackPanel>

              <Grid Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    ColumnDefinitions="90,110,90,*,Auto"
                    ColumnSpacing="{DynamicResource MptSpacingL}">
                <StackPanel>
                  <TextBlock Classes="MptMeta" Text="PID" />
                  <TextBlock Classes="ServiceMetricValue" Text="{Binding Pid}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="MptMeta" Text="Uptime" />
                  <TextBlock Classes="ServiceMetricValue" Text="{Binding Uptime}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Classes="MptMeta" Text="Restarts" />
                  <TextBlock Classes="ServiceMetricValue" Text="{Binding RestartCount}" />
                </StackPanel>
                <StackPanel Grid.Column="3" IsVisible="{Binding HasError}">
                  <TextBlock Classes="MptMeta"
                             Foreground="{DynamicResource MptBrushDanger}"
                             Text="Last error" />
                  <TextBlock Classes="MptMeta"
                             Text="{Binding LastError}"
                             TextWrapping="Wrap"
                             MaxLines="2" />
                </StackPanel>
                <controls:MptButton Grid.Column="4"
                                    Content="{Binding AutostartLabel}"
                                    Command="{Binding ToggleAutostartCommand}"
                                    VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
