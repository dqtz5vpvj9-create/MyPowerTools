<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
  <StackPanel Margin="{DynamicResource MptPagePadding}" Spacing="{DynamicResource MptSpacingM}">
    <StackPanel Spacing="{DynamicResource MptSpacingXs}">
      <TextBlock Classes="MptPageTitle" Text="{Binding Title}" />
      <TextBlock Classes="MptPageSubtitle" Text="{Binding Subtitle}" />
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Metrics}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MetricViewModel">
          <Border Classes="MptInset" Margin="0,0,8,8">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{Binding Value}" />
              <TextBlock Classes="MptMeta" Text="{Binding Label}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="MptSectionTitle" Text="Runtime Processes" />
    <ItemsControl ItemsSource="{Binding Processes}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:RuntimeProcessViewModel">
          <Border Classes="MptCard" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <TextBlock FontWeight="SemiBold" Text="{Binding PoolKey}" />
              <TextBlock Grid.Column="1" Classes="MptMeta" Text="{Binding State}" />
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="{DynamicResource MptSpacingS}">
                <TextBlock Classes="MptMeta" Text="{Binding TransportKind}" />
                <TextBlock Classes="MptMeta" Text="{Binding ProcessId}" />
                <TextBlock Classes="MptMeta" Text="{Binding RestartPolicy}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
