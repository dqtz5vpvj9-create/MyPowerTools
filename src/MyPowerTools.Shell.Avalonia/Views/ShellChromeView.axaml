<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.ShellChromeView"
             x:DataType="vm:ShellChromeViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ShellNavigationItemTemplate"
                  x:DataType="vm:ShellNavigationItemViewModel">
      <Grid Width="{Binding ItemWidth}"
            Margin="{DynamicResource MptUniformXs}">
        <controls:MptButton Classes="MptNavButton"
                            Classes.selected="{Binding IsSelected}"
                            Command="{Binding NavigateCommand}"
                            IsEnabled="{Binding IsEnabled}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            MinHeight="{DynamicResource MptDensityNavigationHeight}"
                            ToolTip.Tip="{Binding DisplayLabel}"
                            Padding="{DynamicResource MptNoThickness}">
          <Grid ColumnDefinitions="4,40,*"
                Margin="{DynamicResource MptGapRightM}">
            <Border Classes="MptNavIndicator"
                    Width="3"
                    Height="20"
                    IsVisible="{Binding IsSelected}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
            <Grid Grid.Column="1"
                  Width="30"
                  Height="30"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
              <TextBlock Text="{Binding IconGlyph}"
                         FontFamily="{DynamicResource MptFontFamilyIcons}"
                         FontSize="{DynamicResource MptFontSizeCardTitle}"
                         IsVisible="{Binding !IsMonogram}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <Border Width="28"
                      Height="28"
                      CornerRadius="{DynamicResource MptRadiusControl}"
                      Background="{DynamicResource MptBrushSurfaceInset}"
                      IsVisible="{Binding IsMonogram}">
                <TextBlock Text="{Binding IconGlyph}"
                           FontFamily="{DynamicResource MptFontFamilyBody}"
                           FontSize="{DynamicResource MptFontSizeMicro}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MptBrushAccent}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </Grid>
            <TextBlock Grid.Column="2"
                       Text="{Binding DisplayLabel}"
                       IsVisible="{Binding IsLabelVisible}"
                       Margin="{DynamicResource MptGapRightL}"
                       FontSize="{DynamicResource MptFontSizeBody}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </Grid>
        </controls:MptButton>
        <controls:MptButton Width="24"
                            Height="24"
                            MinHeight="24"
                            Padding="{DynamicResource MptNoThickness}"
                            Margin="{DynamicResource MptGapRightS}"
                            Content="×"
                            FontFamily="{DynamicResource MptFontFamilyBody}"
                            FontSize="{DynamicResource MptFontSizeBody}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource MptBrushTextSecondary}"
                            Command="{Binding CloseCommand}"
                            IsVisible="{Binding IsCloseButtonVisible}"
                            Background="{DynamicResource MptBrushTransparent}"
                            BorderBrush="{DynamicResource MptBrushTransparent}"
                            ToolTip.Tip="Close web page"
                            AutomationProperties.Name="Close web page"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WebSurfaceHeaderTemplate"
                  x:DataType="vm:ExternalSdkToolViewModel">
      <Grid ColumnDefinitions="Auto,180,*,Auto,Auto,Auto,Auto"
            ColumnSpacing="{DynamicResource MptSpacingS}"
            VerticalAlignment="Center">
        <controls:MptButton Content="All tools"
                            Command="{Binding ReturnToToolsCommand}"
                            MinHeight="32"
                            Padding="{DynamicResource MptCompactBadgePadding}" />
        <controls:MptSearchBox Grid.Column="1"
                               Text="{Binding EditableTitle, Mode=TwoWay}"
                               PlaceholderText="Page title"
                               ToolTip.Tip="Edit page title"
                               VerticalContentAlignment="Center" />
        <controls:MptSearchBox Grid.Column="2"
                               Text="{Binding Address, Mode=TwoWay}"
                               PlaceholderText="Enter an HTTP or HTTPS address"
                               ToolTip.Tip="{Binding AddressError}"
                               VerticalContentAlignment="Center" />
        <controls:MptButton Grid.Column="3"
                            Content="Go"
                            Command="{Binding NavigateCommand}"
                            MinHeight="32"
                            Padding="{DynamicResource MptCompactBadgePadding}" />
        <controls:MptButton Grid.Column="4"
                            Content="Settings"
                            Command="{Binding OpenSettingsCommand}"
                            IsVisible="{Binding CanOpenSettings}"
                            MinHeight="32"
                            Padding="{DynamicResource MptCompactBadgePadding}" />
        <controls:MptButton Grid.Column="5"
                            Content="Open externally"
                            Command="{Binding OpenExternalCommand}"
                            IsVisible="{Binding CanOpenExternal}"
                            MinHeight="32"
                            Padding="{DynamicResource MptCompactBadgePadding}" />
        <controls:MptButton Grid.Column="6"
                            Classes="MptPrimaryButton"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            MinHeight="32"
                            Padding="{DynamicResource MptCompactBadgePadding}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid x:Name="ShellLayoutGrid"
        Background="{DynamicResource MptBrushAppBackground}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="{DynamicResource MptLayoutTopBarGridHeight}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- PowerToys-style unified title and search band. -->
    <Border Grid.ColumnSpan="2"
            Background="{DynamicResource MptBrushShellChrome}"
            BorderBrush="{DynamicResource MptBrushDivider}"
            BorderThickness="0,0,0,1"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid x:Name="TitleBarGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="168" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="BrandHost"
              Margin="{DynamicResource MptShellBrandMargin}"
              ColumnDefinitions="32,*"
              ColumnSpacing="{DynamicResource MptSpacingM}"
              VerticalAlignment="Center">
          <Border Width="32"
                  Height="32"
                  CornerRadius="{DynamicResource MptRadiusCard}"
                  Background="{DynamicResource MptBrushAccent}">
            <Grid Margin="{DynamicResource MptUniformS}"
                  RowDefinitions="*,*"
                  ColumnDefinitions="*,*"
                  RowSpacing="{DynamicResource MptSpacing2Xs}"
                  ColumnSpacing="{DynamicResource MptSpacing2Xs}">
              <Border CornerRadius="{DynamicResource MptRadiusXs}" Background="{DynamicResource MptBrushAccentText}" />
              <Border Grid.Column="1" CornerRadius="{DynamicResource MptRadiusXs}" Background="{DynamicResource MptBrushAccentText}" Opacity="0.82" />
              <Border Grid.Row="1" CornerRadius="{DynamicResource MptRadiusXs}" Background="{DynamicResource MptBrushAccentText}" Opacity="0.82" />
              <Border Grid.Row="1" Grid.Column="1" CornerRadius="{DynamicResource MptRadiusXs}" Background="{DynamicResource MptBrushAccentText}" />
            </Grid>
          </Border>
          <TextBlock x:Name="BrandTitle"
                     Grid.Column="1"
                     Text="MyPowerTools"
                     FontSize="{DynamicResource MptFontSizeCardTitle}"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="TitleContentHost"
              Grid.Column="1"
              Margin="{DynamicResource MptTitleSearchMargin}"
              ColumnDefinitions="40,*,Auto"
              ColumnSpacing="{DynamicResource MptSpacingS}"
              chrome:WindowDecorationProperties.ElementRole="User">
          <controls:MptButton x:Name="NavigationModeButton"
                              Width="36"
                              Height="36"
                              MinHeight="36"
                              Padding="{DynamicResource MptNoThickness}"
                              Content="&#xE700;"
                              FontFamily="{DynamicResource MptFontFamilyIcons}"
                              Background="{DynamicResource MptBrushTransparent}"
                              BorderBrush="{DynamicResource MptBrushTransparent}"
                              Click="OnNavigationModeButtonClick"
                              ToolTip.Tip="Navigation: expanded"
                              AutomationProperties.Name="Change navigation mode"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          <ContentControl x:Name="PageHeaderHost"
                          Grid.Column="1"
                          Content="{Binding HeaderContent}"
                          ContentTemplate="{StaticResource WebSurfaceHeaderTemplate}"
                          IsVisible="{Binding HasHeaderContent}"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center" />
          <Border Grid.Column="2"
                  MaxWidth="420"
                  Padding="{DynamicResource MptCompactBadgePadding}"
                  CornerRadius="{DynamicResource MptRadiusControl}"
                  Background="{DynamicResource MptBrushSurfaceInset}"
                  ToolTip.Tip="{Binding RuntimeIdentityText}"
                  VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,Auto"
                  ColumnSpacing="{DynamicResource MptSpacingS}">
              <Border Padding="{DynamicResource MptCompactBadgePadding}"
                      CornerRadius="{DynamicResource MptRadiusControl}"
                      Background="{DynamicResource MptBrushAccent}">
                <TextBlock Text="{Binding RuntimeModeLabel}"
                           FontSize="{DynamicResource MptFontSizeMicro}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MptBrushAccentText}"
                           VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Column="1"
                         MaxWidth="300"
                         Text="{Binding RuntimeLocation}"
                         IsVisible="{Binding HasRuntimeLocation}"
                         FontSize="{DynamicResource MptFontSizeCaption}"
                         Foreground="{DynamicResource MptBrushTextSecondary}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Grid>

        <!-- Reserved for native caption controls when the client area extends into the title bar. -->
        <Border Grid.Column="2" Background="{DynamicResource MptBrushTransparent}" />
      </Grid>
    </Border>

    <Border x:Name="NavigationHost"
            Grid.Row="1"
            Background="{DynamicResource MptBrushNavigationBackground}"
            BorderBrush="{DynamicResource MptBrushDivider}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel x:Name="MainNavigationStack"
                    Margin="{DynamicResource MptShellNavigationMargin}"
                    Spacing="{DynamicResource MptSpacingXs}">
          <ItemsControl ItemsSource="{Binding TopNavigationItems}"
                        ItemTemplate="{StaticResource ShellNavigationItemTemplate}" />

          <Border Height="1"
                  Margin="{DynamicResource MptSidebarDividerMargin}"
                  Background="{DynamicResource MptBrushDivider}" />

          <TextBlock x:Name="ToolSectionLabel"
                     Text="TOOLS"
                     Classes="MptMeta"
                     FontSize="{DynamicResource MptFontSizeCaption}"
                     FontWeight="SemiBold"
                     Margin="{DynamicResource MptSectionLabelMargin}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding ToolNavigationItems}"
                        ItemTemplate="{StaticResource ShellNavigationItemTemplate}" />
        </ScrollViewer>

        <StackPanel x:Name="FooterNavigationStack"
                    Grid.Row="2"
                    Margin="{DynamicResource MptShellFooterMargin}"
                    Spacing="{DynamicResource MptSpacingXs}">
          <Border Height="1"
                  Margin="{DynamicResource MptFooterDividerMargin}"
                  Background="{DynamicResource MptBrushDivider}" />
          <ItemsControl ItemsSource="{Binding FooterNavigationItems}"
                        ItemTemplate="{StaticResource ShellNavigationItemTemplate}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1"
          Grid.Row="1"
          RowDefinitions="Auto,*"
          Background="{DynamicResource MptBrushAppBackground}">
      <ItemsControl Grid.Row="0"
                    ItemsSource="{Binding InfoBars}"
                    Margin="{DynamicResource MptInfoBarHostMargin}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border IsVisible="{Binding IsVisible}"
                    Margin="{DynamicResource MptGapTopS}"
                    Padding="{DynamicResource MptInfoBarPadding}"
                    CornerRadius="{DynamicResource MptRadiusCard}"
                    BorderThickness="0,0,0,0"
                    Background="{DynamicResource MptBrushCardBackground}"
                    BoxShadow="{DynamicResource MptShadowRaised}">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding SeverityIcon}"
                           FontFamily="{DynamicResource MptFontFamilyIcons}"
                           FontSize="{DynamicResource MptFontSizeCardTitle}"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource MptGapRightS}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <controls:MptButton Grid.Column="2"
                                    Content="{Binding ActionLabel}"
                                    Command="{Binding ActionCommand}"
                                    IsVisible="{Binding HasAction}"
                                    Classes="MptPrimaryButton"
                                    Margin="{DynamicResource MptGapLeftS}"
                                    VerticalAlignment="Center"
                                    MinWidth="60" />
                <controls:MptButton Grid.Column="3"
                                    Content="&#xE711;"
                                    FontFamily="{DynamicResource MptFontFamilyIcons}"
                                    Command="{Binding DismissCommand}"
                                    Background="{DynamicResource MptBrushTransparent}"
                                    BorderBrush="{DynamicResource MptBrushTransparent}"
                                    Width="28" Height="28"
                                    Padding="{DynamicResource MptNoThickness}"
                                    Margin="{DynamicResource MptGapLeftXs}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Dismiss" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ScrollViewer Grid.Row="1"
                    Margin="{DynamicResource MptPagePadding}"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="ContentHost"
                        MaxWidth="{DynamicResource MptLayoutPageMaxWidth}"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Stretch" />
      </ScrollViewer>
      <Grid x:Name="WebSurfaceHost"
            Grid.Row="1"
            Margin="{DynamicResource MptPagePadding}"
            IsVisible="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
    </Grid>

    <Grid x:Name="GlobalOverlayHost"
          Grid.ColumnSpan="2"
          Grid.RowSpan="2"
          IsVisible="{Binding IsCommandPaletteOpen}">
      <Border x:Name="CommandFlyout"
              Width="{DynamicResource MptLayoutSearchMaxWidth}"
              MaxHeight="420"
              Padding="{DynamicResource MptNoThickness}"
              CornerRadius="{DynamicResource MptRadiusOverlay}"
              BorderBrush="{DynamicResource MptBrushBorderStrong}"
              BorderThickness="{DynamicResource MptBorderThickness}"
              Background="{DynamicResource MptBrushCardBackground}"
              BoxShadow="{DynamicResource MptShadowOverlay}"
              ClipToBounds="True"
              HorizontalAlignment="Left"
              VerticalAlignment="Top">
        <Grid>
          <Grid RowDefinitions="Auto,*">
            <Grid Margin="{DynamicResource MptUniformS}"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="{DynamicResource MptSpacingS}">
              <controls:MptSearchBox x:Name="SearchBox"
                                     Grid.ColumnSpan="3"
                                     PlaceholderText="Search tools and actions"
                                     Padding="{DynamicResource MptTitleSearchPadding}" />
              <TextBlock Text="&#xE721;"
                         FontFamily="{DynamicResource MptFontFamilyIcons}"
                         FontSize="{DynamicResource MptFontSizeBody}"
                         Foreground="{DynamicResource MptBrushTextSecondary}"
                         Margin="{DynamicResource MptGapLeftM}"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />
              <Border Padding="{DynamicResource MptCompactBadgePadding}"
                      Grid.Column="1"
                      CornerRadius="{DynamicResource MptRadiusControl}"
                      BorderBrush="{DynamicResource MptBrushDivider}"
                      BorderThickness="1"
                      Background="{DynamicResource MptBrushSurfaceMuted}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      IsVisible="{Binding HasCommandPaletteShortcutHint}">
                <TextBlock Text="{Binding CommandPaletteShortcutHint}"
                           Classes="MptMeta"
                           MaxWidth="220"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource MptFontSizeMeta}" />
              </Border>
              <controls:MptButton Grid.Column="2"
                                  Width="28"
                                  Height="28"
                                  Padding="{DynamicResource MptNoThickness}"
                                  Content="&#xE8BB;"
                                  FontFamily="{DynamicResource MptFontFamilyIcons}"
                                  Background="{DynamicResource MptBrushTransparent}"
                                  BorderBrush="{DynamicResource MptBrushTransparent}"
                                  Command="{Binding CloseCommandPaletteCommand}"
                                  ToolTip.Tip="Close search results"
                                  AutomationProperties.Name="Close search results"
                                  VerticalAlignment="Center" />
            </Grid>
            <ContentControl x:Name="CommandPanel"
                            Grid.Row="1" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="PermissionOverlayHost"
          Grid.ColumnSpan="2"
          Grid.RowSpan="2"
          Background="{DynamicResource MptBrushOverlayScrim}"
          IsVisible="{Binding IsPermissionPromptOpen}">
      <Border Width="{DynamicResource MptLayoutPermissionPromptWidth}"
              Padding="{DynamicResource MptOverlayPanelPadding}"
              CornerRadius="{DynamicResource MptRadiusOverlay}"
              BorderBrush="{DynamicResource MptBrushWarning}"
              BorderThickness="{DynamicResource MptBorderThickness}"
              Background="{DynamicResource MptBrushCardBackground}"
              BoxShadow="{DynamicResource MptShadowRaised}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto"
                Margin="{DynamicResource MptGapBottomL}">
            <StackPanel Spacing="{DynamicResource MptSpacingXs}">
              <TextBlock Classes="MptSectionTitle"
                         Text="Permission required" />
              <TextBlock Classes="MptMeta"
                         Text="Review the requested system action before continuing." />
            </StackPanel>
            <controls:MptButton Grid.Column="1"
                                Content="Dismiss"
                                Command="{Binding DismissPermissionPromptCommand}"
                                MinWidth="76" />
          </Grid>
          <ContentControl x:Name="PermissionPanel"
                          Grid.Row="1" />
        </Grid>
      </Border>
    </Grid>

    <!-- Kept as nonvisual state endpoints for controller/test compatibility. -->
    <Grid IsVisible="False">
      <controls:MptButton x:Name="RefreshButton"
                          Command="{Binding RefreshCommand}" />
      <TextBlock x:Name="StatusBar"
                 Text="{Binding StatusText}" />
      <TextBlock x:Name="RunnerStatus"
                 Text="{Binding RunnerStatusText}" />
    </Grid>
    <ContentControl x:Name="AuditPanel"
                    IsVisible="False" />
  </Grid>
</UserControl>
