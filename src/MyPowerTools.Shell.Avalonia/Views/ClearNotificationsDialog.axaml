<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MyPowerTools.UI.Controls"
        x:Class="MyPowerTools.Shell.Avalonia.Views.ClearNotificationsDialog"
        Title="Clear notifications"
        Width="480"
        Height="176"
        CanResize="False"
        Background="{DynamicResource MptBrushAppBackground}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="{DynamicResource MptUniformXl}"
        RowDefinitions="*,Auto"
        RowSpacing="{DynamicResource MptSpacingL}">
    <TextBlock x:Name="PromptText"
               Classes="MptBody"
               TextWrapping="Wrap"
               VerticalAlignment="Center" />
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                Spacing="{DynamicResource MptSpacingS}"
                HorizontalAlignment="Right">
      <controls:MptButton Content="Cancel"
                          MinWidth="84"
                          Click="OnCancelClick" />
      <controls:MptButton Classes="MptPrimaryButton"
                          Content="Clear all"
                          MinWidth="84"
                          Click="OnClearClick" />
    </StackPanel>
  </Grid>
</Window>
