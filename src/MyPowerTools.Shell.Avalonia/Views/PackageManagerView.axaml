<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.PackageManagerView"
             x:DataType="vm:PackageManagerViewModel">
  <StackPanel Margin="{DynamicResource MptPagePadding}" Spacing="{DynamicResource MptSpacingM}">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}">
        <TextBlock Classes="MptPageTitle" Text="{Binding Title}" />
        <TextBlock Classes="MptPageSubtitle" Text="{Binding Subtitle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Classes="MptActionBar" Orientation="Horizontal">
        <controls:MptButton Content="Repair selected"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
        <controls:MptButton Content="Refresh trust"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
      </StackPanel>
    </Grid>

    <Border Classes="MptSettingsSection">
      <StackPanel Spacing="{DynamicResource MptSpacingS}">
        <TextBlock Classes="MptSectionTitle" Text="产品更新 (OTA)" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingM}">
          <StackPanel Spacing="{DynamicResource MptSpacingXs}">
            <TextBlock Classes="MptMeta" Text="{Binding UpdateVersionText}" />
            <TextBlock Classes="MptPageSubtitle" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding UpdateProgressPercent}"
                         IsVisible="{Binding IsUpdateProgressVisible}"
                         Height="8" />
            <TextBlock Classes="MptMeta"
                       Text="{Binding UpdateProgressText}"
                       IsVisible="{Binding IsUpdateProgressVisible}" />
            <Border Classes="MptPermissionPrompt"
                    IsVisible="{Binding IsUpdateConsentVisible}">
              <StackPanel Spacing="{DynamicResource MptSpacingS}">
                <TextBlock Classes="MptSectionTitle"
                           Text="{Binding UpdateConsentTitle}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="MptPageSubtitle"
                           Text="{Binding UpdateConsentIntro}"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding UpdateConsentCloseItems}"
                              IsVisible="{Binding HasUpdateConsentCloseItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OtaConsentItemViewModel">
                      <TextBlock Classes="MptBody"
                                 Text="{Binding Text}"
                                 TextWrapping="Wrap"
                                 Margin="{DynamicResource MptGapBottomXs}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="MptMeta"
                           Text="{Binding UpdateConsentFootnote}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasUpdateConsentFootnote}" />
                <StackPanel Classes="MptActionBar"
                            Orientation="Horizontal"
                            Spacing="{DynamicResource MptSpacingS}">
                  <controls:MptButton Content="取消"
                                      Command="{Binding CancelUpdateConsentCommand}"
                                      MinWidth="{DynamicResource MptPackageActionWidth}" />
                  <controls:MptButton Classes="MptPrimaryButton"
                                      Content="{Binding UpdateConsentConfirmText}"
                                      Command="{Binding ConfirmUpdateCommand}"
                                      MinWidth="{DynamicResource MptPackageActionWidth}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Classes="MptActionBar"
                      Orientation="Horizontal"
                      Spacing="{DynamicResource MptSpacingS}">
            <controls:MptButton Content="检查更新"
                                Command="{Binding CheckUpdateCommand}"
                                MinWidth="{DynamicResource MptPackageActionWidth}" />
            <controls:MptButton Classes="MptPrimaryButton"
                                Content="立即升级"
                                Command="{Binding ApplyUpdateCommand}"
                                MinWidth="{DynamicResource MptPackageActionWidth}"
                                IsVisible="{Binding CanShowApplyButton}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="MptSettingsSection">
      <StackPanel Spacing="{DynamicResource MptSpacingS}">
        <TextBlock Classes="MptSectionTitle" Text="Package Operations" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource MptSpacingM}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingS}">
            <controls:MptTextBox PlaceholderText="Package source directory"
                                 Text="{Binding InstallSourceDirectory, Mode=TwoWay}"
                                 MinWidth="{DynamicResource MptPackageSourceInputWidth}" />
            <controls:MptButton Grid.Column="1"
                                Classes="MptPrimaryButton"
                                Content="Install"
                                Command="{Binding InstallCommand}"
                                MinWidth="{DynamicResource MptPackageActionWidth}" />
          </Grid>
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource MptSpacingS}">
            <controls:MptTextBox PlaceholderText="Package id"
                                 Text="{Binding RollbackPackageId, Mode=TwoWay}"
                                 MinWidth="{DynamicResource MptPackageIdInputWidth}" />
            <controls:MptButton Grid.Column="1"
                                Content="Rollback"
                                Command="{Binding RollbackCommand}"
                                MinWidth="{DynamicResource MptPackageActionWidth}" />
          </Grid>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="MptToolbar">
      <StackPanel Classes="MptToolbar" Orientation="Horizontal">
        <controls:MptTextBox PlaceholderText="Search packages"
                             MinWidth="{DynamicResource MptPackageIdInputWidth}" />
        <controls:MptButton Content="Trusted"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
        <controls:MptButton Content="Warnings"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
        <controls:MptButton Content="Updates"
                            MinWidth="{DynamicResource MptDensityActionMinWidth}" />
      </StackPanel>
    </Border>

    <TextBlock Classes="MptPageSubtitle"
               Text="No packages."
               IsVisible="{Binding IsEmpty}" />

    <ItemsControl ItemsSource="{Binding Packages}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemWidth="{DynamicResource MptLayoutPackageCardWidth}" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PackageSummaryViewModel">
          <Border Classes="MptPackageCard" Margin="{DynamicResource MptWrapItemMargin}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="{DynamicResource MptSpacingXs}">
                  <TextBlock Classes="MptSectionTitle" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                  <TextBlock Classes="MptMeta" Text="{Binding PackageId}" TextWrapping="Wrap" />
                  <TextBlock Classes="MptPageSubtitle" Text="{Binding Publisher}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="MptStatusBadge">
                  <TextBlock Classes="MptMeta" Text="{Binding TrustState}" />
                </Border>
              </Grid>

              <ItemsControl Grid.Row="1" ItemsSource="{Binding Metrics}" Margin="{DynamicResource MptGapTopM}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MetricViewModel">
                    <Grid Margin="{DynamicResource MptGapBottomXs}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource MptLayoutMetricLabelGridWidth}" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Classes="MptMeta" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Grid.Row="2" Spacing="{DynamicResource MptSpacingXs}">
                <TextBlock Classes="MptMeta" Text="{Binding ModuleIdsText}" TextWrapping="Wrap" />
                <TextBlock Classes="MptMeta" Text="{Binding Directory}" TextTrimming="CharacterEllipsis" />
                <ItemsControl ItemsSource="{Binding ModuleLinks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PackageModuleLinkViewModel">
                      <controls:MptButton Content="{Binding ModuleId}"
                                          Command="{Binding OpenCommand}"
                                          Margin="{DynamicResource MptWrapItemMargin}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="{DynamicResource MptSpacingS}">
                <controls:MptButton Classes="MptPrimaryButton"
                                    Content="Repair"
                                    Command="{Binding RepairCommand}"
                                    MinWidth="{DynamicResource MptPackageActionWidth}" />
                <controls:MptButton Content="Uninstall"
                                    Command="{Binding UninstallCommand}"
                                    MinWidth="{DynamicResource MptPackageActionWidth}" />
                <controls:MptButton Content="Rollback"
                                    Command="{Binding RollbackCommand}"
                                    MinWidth="{DynamicResource MptPackageActionWidth}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
