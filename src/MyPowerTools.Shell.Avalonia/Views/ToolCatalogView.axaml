<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:adaptive="using:MyPowerTools.AvaloniaSdk"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.ToolCatalogView"
             x:DataType="vm:ToolCatalogViewModel">
  <UserControl.Styles>
    <Style Selector="Border.MptToolRow">
      <Setter Property="Padding" Value="{DynamicResource MptToolRowPadding}" />
      <Setter Property="Margin" Value="{DynamicResource MptGapBottomS}" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
      <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
      <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
      <Setter Property="BoxShadow" Value="{DynamicResource MptShadowCard}" />
    </Style>
    <Style Selector="Border.MptToolRow:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
      <Setter Property="BoxShadow" Value="{DynamicResource MptShadowRaised}" />
    </Style>
  </UserControl.Styles>

  <StackPanel MaxWidth="{DynamicResource MptLayoutPageMaxWidth}"
              HorizontalAlignment="Stretch"
              Spacing="{DynamicResource MptSpacingL}">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="{DynamicResource MptSpacingM}">
      <StackPanel Spacing="{DynamicResource MptSpacingXs}"
                  VerticalAlignment="Center">
        <TextBlock Classes="MptPageTitle"
                   Text="{Binding Title}" />
        <TextBlock Classes="MptPageSubtitle"
                   Text="{Binding Subtitle}" />
      </StackPanel>
      <controls:MptButton Grid.Column="1"
                          Classes="MptIconOnlyButton outlined"
                          Command="{Binding RefreshCommand}"
                          ToolTip.Tip="Refresh"
                          AutomationProperties.Name="Refresh tools"
                          VerticalAlignment="Center">
        <Path Classes="MptInlineIcon"
              Data="{DynamicResource MptIconGeoRefresh}" />
      </controls:MptButton>
    </Grid>

    <StackPanel IsVisible="{Binding IsLoading}"
                Spacing="{DynamicResource MptSpacingS}">
      <Border Classes="MptLoadingSkeleton" Height="84" />
      <Border Classes="MptLoadingSkeleton" Height="84" />
      <Border Classes="MptLoadingSkeleton" Height="84" />
    </StackPanel>


    <Border Classes="MptEmptyState"
            IsVisible="{Binding IsEmpty}">
      <Grid adaptive:MptAdaptiveLayout.StackBelow="600" ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="{DynamicResource MptSpacingL}">
        <controls:MptToolIcon IconKey="toolkit" />
        <StackPanel Grid.Column="1"
                    Spacing="{DynamicResource MptSpacingXs}"
                    VerticalAlignment="Center">
          <TextBlock Classes="MptCardTitle"
                     Text="No tools yet" />
          <TextBlock Classes="MptPageSubtitle"
                     Text="Tools you install will show up here." />
        </StackPanel>
        <controls:MptButton Grid.Column="2"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            VerticalAlignment="Center" />
      </Grid>
    </Border>

    <StackPanel IsVisible="{Binding IsReady}"
                Spacing="{DynamicResource MptSpacingM}">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="{DynamicResource MptSpacingS}">
        <controls:MptSearchBox Text="{Binding Query, Mode=TwoWay}"
                               PlaceholderText="Search by name or what you want to do">
          <controls:MptSearchBox.InnerLeftContent>
            <Path Classes="MptInlineIcon"
                  Data="{DynamicResource MptIconGeoSearch}"
                  Stroke="{DynamicResource MptBrushTextMuted}"
                  Margin="{DynamicResource MptGapLeftXs}" />
          </controls:MptSearchBox.InnerLeftContent>
        </controls:MptSearchBox>
        <controls:MptButton Grid.Column="1"
                            Classes="MptSubtleButton"
                            Content="Clear"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding HasQuery}" />
      </Grid>

      <WrapPanel Orientation="Horizontal">
        <controls:MptButton Classes="MptFilterChip"
                            Classes.selected="{Binding IsAllFilter}"
                            Content="{Binding AllFilterLabel}"
                            Command="{Binding ShowAllCommand}"
                            Margin="{DynamicResource MptGapRightS}" />
        <controls:MptButton Classes="MptFilterChip"
                            Classes.selected="{Binding IsReadyFilter}"
                            Content="{Binding ReadyFilterLabel}"
                            Command="{Binding ShowReadyCommand}"
                            Margin="{DynamicResource MptGapRightS}" />
        <controls:MptButton Classes="MptFilterChip"
                            Classes.selected="{Binding IsLaterFilter}"
                            Content="{Binding LaterFilterLabel}"
                            Command="{Binding ShowLaterCommand}"
                            IsVisible="{Binding HasLaterTools}"
                            Margin="{DynamicResource MptGapRightS}" />
        <controls:MptButton Classes="MptFilterChip"
                            Classes.selected="{Binding IsFavoritesFilter}"
                            Content="{Binding FavoritesFilterLabel}"
                            Command="{Binding ShowFavoritesCommand}" />
      </WrapPanel>

      <Border Classes="MptEmptyState"
              IsVisible="{Binding IsSearchEmpty}">
        <Grid adaptive:MptAdaptiveLayout.StackBelow="600" ColumnDefinitions="*,Auto"
              ColumnSpacing="{DynamicResource MptSpacingM}">
          <StackPanel Spacing="{DynamicResource MptSpacingXs}">
            <TextBlock Classes="MptCardTitle"
                       Text="{Binding EmptyResultTitle}" />
            <TextBlock Classes="MptPageSubtitle"
                       Text="{Binding EmptyResultDetail}" />
          </StackPanel>
          <controls:MptButton Grid.Column="1"
                              Content="Clear search"
                              Command="{Binding ClearSearchCommand}"
                              IsVisible="{Binding HasQuery}"
                              VerticalAlignment="Center" />
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding VisibleTools}"
                    IsVisible="{Binding HasSearchResults}"
                    Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolCardViewModel">
            <Border Classes="MptToolRow"
                    Classes.inactive="{Binding !CanOpen}">
              <Grid adaptive:MptAdaptiveLayout.StackBelow="600"
                    ColumnSpacing="{DynamicResource MptSpacingL}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ToolStatus" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ToolAction" />
                </Grid.ColumnDefinitions>
                <controls:MptToolIcon IconKey="{Binding ToolId}" />

                <StackPanel Grid.Column="1"
                            Spacing="{DynamicResource MptSpacing2Xs}"
                            VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal"
                              Spacing="{DynamicResource MptSpacingS}">
                    <TextBlock Classes="MptCardTitle"
                               Text="{Binding Title}"
                               VerticalAlignment="Center" />
                    <Border Classes="MptChip"
                            IsVisible="{Binding !!Category}">
                      <TextBlock Text="{Binding Category}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Classes="MptPageSubtitle"
                             Text="{Binding Description}"
                             MaxLines="2"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="MptMeta"
                             Text="{Binding StatusHint}"
                             IsVisible="{Binding HasStatusHint}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap" />
                </StackPanel>

                <Border Grid.Column="2"
                        Classes="MptStatusBadge"
                        Classes.running="{Binding IsReadyStatus}"
                        Classes.degraded="{Binding IsAttentionStatus}"
                        Classes.error="{Binding IsUnavailable}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal"
                              Spacing="{DynamicResource MptSpacingXs}">
                    <Ellipse Classes="MptStatusDot" />
                    <TextBlock Text="{Binding StatusLabel}" />
                  </StackPanel>
                </Border>

                <controls:MptButton Grid.Column="3"
                                    Classes="MptIconOnlyButton MptStarToggle"
                                    Classes.favorite="{Binding IsFavorite}"
                                    Command="{Binding ToggleFavoriteCommand}"
                                    ToolTip.Tip="{Binding FavoriteActionLabel}"
                                    AutomationProperties.Name="{Binding FavoriteAutomationName}"
                                    VerticalAlignment="Center">
                  <Path />
                </controls:MptButton>

                <controls:MptButton Grid.Column="4"
                                    Classes="MptPrimaryButton"
                                    MinWidth="{DynamicResource MptToolActionMinWidth}"
                                    Content="{Binding PrimaryActionLabel}"
                                    Command="{Binding OpenCommand}"
                                    IsVisible="{Binding CanOpen}"
                                    AutomationProperties.Name="{Binding OpenAutomationName}"
                                    VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
