<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.ModulesView"
             x:DataType="vm:ModulesViewModel">
  <StackPanel Margin="{DynamicResource MptPagePadding}" Spacing="{DynamicResource MptSpacingM}">
    <StackPanel Spacing="{DynamicResource MptSpacingXs}">
      <TextBlock Classes="MptPageTitle" Text="{Binding Title}" />
      <TextBlock Classes="MptPageSubtitle" Text="{Binding Subtitle}" />
    </StackPanel>

    <TextBlock Classes="MptPageSubtitle"
               Text="No modules."
               IsVisible="{Binding IsEmpty}" />

    <ItemsControl ItemsSource="{Binding Modules}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ModuleSummaryItemViewModel">
          <Border Classes="MptModuleCard" Margin="{DynamicResource MptGapBottomL}">
            <StackPanel Spacing="{DynamicResource MptSpacingS}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="MptSectionTitle" Text="{Binding DisplayName}" />
                <TextBlock Grid.Column="1" Classes="MptMeta" Text="{Binding State}" />
              </Grid>
              <TextBlock Classes="MptPageSubtitle" Text="{Binding Summary}" />
              <TextBlock Classes="MptMeta" Text="{Binding Identity}" />
              <TextBlock Classes="MptMeta" Text="{Binding PermissionSummary}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MptSpacingS}">
                <controls:MptButton Content="Details" Command="{Binding DetailsCommand}" MinHeight="32" MinWidth="76" />
                <controls:MptButton Content="Settings" Command="{Binding SettingsCommand}" MinHeight="32" MinWidth="76" />
                <controls:MptButton Content="Logs" Command="{Binding LogsCommand}" MinHeight="32" MinWidth="76" />
                <controls:MptButton Content="{Binding ToggleLabel}" Command="{Binding ToggleEnabledCommand}" MinHeight="32" MinWidth="76" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

