<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:adaptive="using:MyPowerTools.AvaloniaSdk"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.UnavailablePageView"
             x:DataType="vm:UnavailablePageViewModel">
  <StackPanel MaxWidth="{DynamicResource MptLayoutSettingsMaxWidth}"
              HorizontalAlignment="Stretch"
              Spacing="{DynamicResource MptSpacingL}">
    <TextBlock Classes="MptPageTitle" Text="{Binding Title}" />
    <Border Classes="MptErrorState">
      <StackPanel Spacing="{DynamicResource MptSpacingM}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />

        <TextBlock Classes="MptMeta"
                   Text="{Binding AttemptText}"
                   IsVisible="{Binding HasAttemptText}"
                   Foreground="{DynamicResource MptBrushWarning}"
                   TextWrapping="Wrap" />

        <StackPanel adaptive:MptAdaptiveLayout.StackBelow="480" Orientation="Horizontal"
                    Spacing="{DynamicResource MptSpacingS}">
          <controls:MptButton Classes="MptPrimaryButton"
                              Content="{Binding ActionLabel}"
                              Command="{Binding RetryCommand}"
                              IsVisible="{Binding HasRetry}"
                              IsEnabled="{Binding IsIdle}" />
          <controls:MptButton Content="Go to Home"
                              Command="{Binding ReturnCommand}"
                              IsVisible="{Binding HasReturnAction}"
                              IsEnabled="{Binding IsIdle}" />
        </StackPanel>

        <TextBlock Classes="MptMeta"
                   Text="{Binding ActionHint}"
                   TextWrapping="Wrap">
          <TextBlock.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasActionHint" />
              <Binding Path="IsIdle" />
              <Binding Path="HasRetry" />
            </MultiBinding>
          </TextBlock.IsVisible>
        </TextBlock>

        <StackPanel Spacing="{DynamicResource MptSpacingXs}"
                    IsVisible="{Binding IsRecovering}">
          <ProgressBar IsIndeterminate="True"
                       HorizontalAlignment="Stretch" />
          <TextBlock Classes="MptMeta"
                     Text="{Binding ProgressText}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Expander Header="Technical details"
                  IsVisible="{Binding HasDetails}"
                  HorizontalAlignment="Stretch">
          <SelectableTextBlock Classes="MptMeta"
                               Text="{Binding Details}"
                               TextWrapping="Wrap" />
        </Expander>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
