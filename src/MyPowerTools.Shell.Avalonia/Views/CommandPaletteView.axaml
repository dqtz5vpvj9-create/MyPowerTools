<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyPowerTools.Shell.Avalonia.ViewModels"
             x:Class="MyPowerTools.Shell.Avalonia.Views.CommandPaletteView"
             x:DataType="vm:CommandPaletteViewModel">
  <StackPanel Margin="{DynamicResource MptPagePadding}" Spacing="{DynamicResource MptSpacingM}">
    <StackPanel Spacing="{DynamicResource MptSpacingXs}">
      <TextBlock Classes="MptPageTitle" Text="{Binding Title}" />
      <TextBlock Classes="MptPageSubtitle" Text="{Binding Subtitle}" />
    </StackPanel>

    <Border Classes="MptInset">
      <TextBlock Classes="MptMeta" Text="{Binding Query}" />
    </Border>

    <TextBlock Classes="MptPageSubtitle"
               Text="No commands found."
               IsVisible="{Binding IsEmpty}" />

    <ItemsControl ItemsSource="{Binding Commands}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CommandItemViewModel">
          <Border Classes="MptCommandItem" Margin="0,0,0,8">
            <StackPanel Spacing="{DynamicResource MptSpacingS}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Grid.Column="1" Classes="MptMeta" Text="{Binding RiskLabel}" />
              </Grid>
              <TextBlock Classes="MptPageSubtitle" Text="{Binding Subtitle}" />
              <TextBlock Classes="MptMeta" Text="{Binding CommandId}" />
              <TextBlock Classes="MptMeta" Text="{Binding ModuleLabel}" />
              <TextBlock Classes="MptMeta"
                         Text="{Binding ParameterSummary}"
                         IsVisible="{Binding HasParameters}" />
              <TextBlock Classes="MptMeta" Text="{Binding ExecutionPreview}" />

              <ItemsControl ItemsSource="{Binding Parameters}" IsVisible="{Binding HasParameters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CommandParameterViewModel">
                    <StackPanel Spacing="{DynamicResource MptSpacingXs}" Margin="0,0,0,6">
                      <TextBlock Classes="MptMeta" Text="{Binding Label}" />
                      <TextBox Text="{Binding Value, Mode=TwoWay}"
                               MinHeight="32"
                               IsVisible="{Binding IsText}" />
                      <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                Content="{Binding Label}"
                                IsVisible="{Binding IsBoolean}" />
                      <TextBlock Classes="MptMeta"
                                 Text="{Binding ValidationMessage}"
                                 IsVisible="{Binding HasValidationError}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="MptMeta"
                         Text="{Binding ValidationMessage}"
                         IsVisible="{Binding HasValidationError}" />
              <TextBlock Classes="MptMeta" Text="{Binding ExecutionStateLabel}" />
              <TextBlock Classes="MptMeta"
                         Text="{Binding ExecutionMessage}"
                         IsVisible="{Binding HasExecutionMessage}" />
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource MptSpacingS}">
                <Button Content="{Binding ExecuteLabel}"
                        Command="{Binding ExecuteCommand}"
                        MinHeight="32"
                        MinWidth="76" />
                <Button Content="{Binding CancelLabel}"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding CanCancel}"
                        MinHeight="32"
                        MinWidth="76" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
