<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:MyPowerTools.UI.Controls">
  <Style Selector="controls|MptButton">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptButtonPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="controls|MptButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccent}" />
  </Style>

  <Style Selector="controls|MptButton:pressed">
    <Setter Property="Background" Value="{DynamicResource MptBrushBorder}" />
  </Style>

  <Style Selector="controls|MptButton:disabled">
    <Setter Property="Opacity" Value="{DynamicResource MptDisabledOpacity}" />
  </Style>

  <Style Selector="controls|MptButton.MptPrimaryButton">
    <Setter Property="Background" Value="{DynamicResource MptBrushAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushAccentText}" />
  </Style>

  <Style Selector="controls|MptButton.MptPrimaryButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource MptBrushAccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccentHover}" />
  </Style>

  <Style Selector="Button.MptButton">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptButtonPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="Button.MptButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceMuted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccent}" />
  </Style>

  <Style Selector="Button.MptButton:pressed">
    <Setter Property="Background" Value="{DynamicResource MptBrushBorder}" />
  </Style>

  <Style Selector="Button.MptButton:disabled">
    <Setter Property="Opacity" Value="{DynamicResource MptDisabledOpacity}" />
  </Style>
</Styles>
