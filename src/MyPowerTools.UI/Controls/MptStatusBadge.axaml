<Styles xmlns="https://github.com/avaloniaui">
  <!-- Soft filled status pill: tinted background + semantic text, no outline. -->
  <Style Selector="Border.MptStatusBadge">
    <Setter Property="Padding" Value="{DynamicResource MptStatusBadgePadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusBadge}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource MptBrushNeutralBackground}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.MptStatusBadge TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeSmall}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextSecondary}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.MptStatusBadge Ellipse.MptStatusDot">
    <Setter Property="Width" Value="{DynamicResource MptStatusDotSize}" />
    <Setter Property="Height" Value="{DynamicResource MptStatusDotSize}" />
    <Setter Property="Fill" Value="{DynamicResource MptBrushTextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.MptStatusBadge.running">
    <Setter Property="Background" Value="{DynamicResource MptBrushSuccessBackground}" />
  </Style>
  <Style Selector="Border.MptStatusBadge.running TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MptBrushSuccess}" />
  </Style>
  <Style Selector="Border.MptStatusBadge.running Ellipse.MptStatusDot">
    <Setter Property="Fill" Value="{DynamicResource MptBrushSuccess}" />
  </Style>

  <Style Selector="Border.MptStatusBadge.degraded">
    <Setter Property="Background" Value="{DynamicResource MptBrushWarningBackground}" />
  </Style>
  <Style Selector="Border.MptStatusBadge.degraded TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MptBrushWarning}" />
  </Style>
  <Style Selector="Border.MptStatusBadge.degraded Ellipse.MptStatusDot">
    <Setter Property="Fill" Value="{DynamicResource MptBrushWarning}" />
  </Style>

  <Style Selector="Border.MptStatusBadge.error">
    <Setter Property="Background" Value="{DynamicResource MptBrushDangerBackground}" />
  </Style>
  <Style Selector="Border.MptStatusBadge.error TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MptBrushDanger}" />
  </Style>
  <Style Selector="Border.MptStatusBadge.error Ellipse.MptStatusDot">
    <Setter Property="Fill" Value="{DynamicResource MptBrushDanger}" />
  </Style>
</Styles>
