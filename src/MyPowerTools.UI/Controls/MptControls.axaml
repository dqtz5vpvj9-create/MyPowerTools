<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:MyPowerTools.UI.Controls">
  <Style Selector="controls|MptTextBox">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptInputPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushControlFillDefault}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushControlStrokeDefault}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeBody}" />
  </Style>

  <Style Selector="controls|MptComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptInputPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
  </Style>

  <Style Selector="controls|MptCheckBox">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityCompactControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityCompactControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptButtonPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushControlFillDefault}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushControlStrokeDefault}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeBody}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource MptBrushControlFillHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="Background" Value="{DynamicResource MptBrushControlFillPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
  </Style>

  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccent}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Button.MptPrimaryButton">
    <Setter Property="Background" Value="{DynamicResource MptBrushAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushAccentText}" />
  </Style>

  <Style Selector="Button.MptPrimaryButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource MptBrushAccentHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccentHover}" />
  </Style>

  <Style Selector="Button.MptPrimaryButton:pressed">
    <Setter Property="Background" Value="{DynamicResource MptBrushAccentPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccentPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushAccentText}" />
  </Style>

  <Style Selector="Button.MptNavButton">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityNavigationHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptInputPadding}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextSecondary}" />
  </Style>

  <Style Selector="Button.MptNavButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource MptBrushNavigationHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="Button.MptNavButton.selected">
    <Setter Property="Background" Value="{DynamicResource MptBrushNavigationSelected}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="Button.MptNavButton.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource MptBrushNavigationSelected}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptInputPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushControlFillDefault}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushControlStrokeDefault}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeBody}" />
  </Style>

  <Style Selector="TextBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource MptBrushControlFillHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="Background" Value="{DynamicResource MptBrushControlFillDefault}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccent}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptInputPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityCompactControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="Border.MptCard">
    <Setter Property="Padding" Value="{DynamicResource MptCardPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
  </Style>

  <Style Selector="Border.MptInset">
    <Setter Property="Padding" Value="{DynamicResource MptCompactPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceInset}" />
  </Style>

  <Style Selector="Border.MptModuleCard">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityCardMinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptCardPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
  </Style>

  <Style Selector="Border.MptStatusBadge">
    <Setter Property="Padding" Value="{DynamicResource MptCompactBadgePadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusBadge}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushNeutral}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.MptMetricTile">
    <Setter Property="MinWidth" Value="{DynamicResource MptDensityMetricTileMinWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityMetricTileMinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptCompactPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceInset}" />
  </Style>

  <Style Selector="Border.MptCommandItem">
    <Setter Property="Padding" Value="{DynamicResource MptListItemPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
  </Style>

  <Style Selector="Border.MptSettingsSection">
    <Setter Property="Padding" Value="{DynamicResource MptCardPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
  </Style>

  <Style Selector="StackPanel.MptSettingsSection">
    <Setter Property="Spacing" Value="{DynamicResource MptSpacingS}" />
  </Style>

  <Style Selector="Border.MptSettingsField">
    <Setter Property="Padding" Value="{DynamicResource MptCompactPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceInset}" />
  </Style>

  <Style Selector="Border.MptLogRow">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityListItemMinHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptListItemPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceInset}" />
  </Style>

  <Style Selector="ListBox.MptLogViewer">
    <Setter Property="FontFamily" Value="{DynamicResource MptFontFamilyMono}" />
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeMeta}" />
  </Style>

  <Style Selector="Border.MptNotificationItem">
    <Setter Property="Padding" Value="{DynamicResource MptListItemPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
  </Style>

  <Style Selector="Border.MptPermissionPrompt">
    <Setter Property="Padding" Value="{DynamicResource MptCardPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushWarning}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushWarningBackground}" />
  </Style>

  <Style Selector="Border.MptEmptyState">
    <Setter Property="Padding" Value="{DynamicResource MptCardPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
  </Style>

  <Style Selector="TextBlock.MptEmptyState">
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextSecondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.MptErrorState">
    <Setter Property="Padding" Value="{DynamicResource MptCardPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushDanger}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
  </Style>

  <Style Selector="Border.MptLoadingSkeleton">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityListItemMinHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceInset}" />
  </Style>

  <Style Selector="Border.MptPageHeader">
    <Setter Property="Padding" Value="{DynamicResource MptActionBarPadding}" />
  </Style>

  <Style Selector="StackPanel.MptPageHeader">
    <Setter Property="Spacing" Value="{DynamicResource MptSpacingXs}" />
  </Style>

  <Style Selector="StackPanel.MptActionBar">
    <Setter Property="Spacing" Value="{DynamicResource MptSpacingS}" />
  </Style>

  <Style Selector="Button.MptActionButton">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityControlHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource MptDensityActionMinWidth}" />
  </Style>
</Styles>
