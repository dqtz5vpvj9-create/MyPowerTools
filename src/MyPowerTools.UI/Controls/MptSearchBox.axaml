<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:MyPowerTools.UI.Controls">
  <Style Selector="controls|MptSearchBox">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptSearchBoxPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
    <Setter Property="Watermark" Value="Search commands" />
  </Style>

  <Style Selector="TextBox.MptSearchBox">
    <Setter Property="MinHeight" Value="{DynamicResource MptDensityControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource MptSearchBoxPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MptBorderThickness}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
    <Setter Property="Watermark" Value="Search commands" />
  </Style>
</Styles>
