<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="MptColorAppBackgroundLight">#F4F5F7</Color>
    <Color x:Key="MptColorShellChromeLight">#FBFBFC</Color>
    <Color x:Key="MptColorSurfaceLight">#FFFFFF</Color>
    <Color x:Key="MptColorSurfaceRaisedLight">#FFFFFF</Color>
    <Color x:Key="MptColorSurfaceMutedLight">#F7F8FA</Color>
    <Color x:Key="MptColorSurfaceInsetLight">#F1F3F6</Color>
    <Color x:Key="MptColorLayerLight">#F7F8FA</Color>
    <Color x:Key="MptColorLayerAltLight">#F1F3F6</Color>
    <Color x:Key="MptColorControlFillLight">#FFFFFF</Color>
    <Color x:Key="MptColorControlFillHoverLight">#F5F6F8</Color>
    <Color x:Key="MptColorControlFillPressedLight">#ECEEF2</Color>
    <Color x:Key="MptColorBorderLight">#E6E8EC</Color>
    <Color x:Key="MptColorBorderStrongLight">#D4D8DF</Color>
    <Color x:Key="MptColorControlStrokeLight">#D0D5DD</Color>
    <Color x:Key="MptColorDividerLight">#EBEDF0</Color>
    <Color x:Key="MptColorNavigationBackgroundLight">#FBFBFC</Color>
    <Color x:Key="MptColorNavigationHoverLight">#F0F2F5</Color>
    <Color x:Key="MptColorNavigationSelectedLight">#EAF1FE</Color>
    <Color x:Key="MptColorTextPrimaryLight">#111827</Color>
    <Color x:Key="MptColorTextSecondaryLight">#4B5563</Color>
    <Color x:Key="MptColorTextMutedLight">#6B7280</Color>
    <Color x:Key="MptColorAccent">#2563EB</Color>
    <Color x:Key="MptColorAccentHover">#1D4ED8</Color>
    <Color x:Key="MptColorAccentPressed">#1E40AF</Color>
    <Color x:Key="MptColorSuccess">#15803D</Color>
    <Color x:Key="MptColorWarning">#B45309</Color>
    <Color x:Key="MptColorDanger">#DC2626</Color>
    <Color x:Key="MptColorInfo">#2563EB</Color>
    <Color x:Key="MptColorWarningBackgroundLight">#FEF3E2</Color>
    <Color x:Key="MptColorInfoBackgroundLight">#EAF1FE</Color>
    <Color x:Key="MptColorDangerBackgroundLight">#FDECEC</Color>
    <Color x:Key="MptColorSuccessBackgroundLight">#E7F6ED</Color>
    <Color x:Key="MptColorScreenEaseAccent">#197765</Color>
    <Color x:Key="MptColorScreenEaseAccentHover">#146454</Color>
    <Color x:Key="MptColorScreenEaseAccentTextMuted">#CFE9E2</Color>
    <Color x:Key="MptColorAppBackgroundDark">#141518</Color>
    <Color x:Key="MptColorShellChromeDark">#1B1D22</Color>
    <Color x:Key="MptColorSurfaceDark">#1F2126</Color>
    <Color x:Key="MptColorSurfaceRaisedDark">#262930</Color>
    <Color x:Key="MptColorSurfaceMutedDark">#23262C</Color>
    <Color x:Key="MptColorSurfaceInsetDark">#17191D</Color>
    <Color x:Key="MptColorLayerDark">#23262C</Color>
    <Color x:Key="MptColorLayerAltDark">#1F2126</Color>
    <Color x:Key="MptColorControlFillDark">#262930</Color>
    <Color x:Key="MptColorControlFillHoverDark">#2D3038</Color>
    <Color x:Key="MptColorControlFillPressedDark">#22252B</Color>
    <Color x:Key="MptColorBorderDark">#2C2F36</Color>
    <Color x:Key="MptColorBorderStrongDark">#3A3E47</Color>
    <Color x:Key="MptColorControlStrokeDark">#41454F</Color>
    <Color x:Key="MptColorDividerDark">#2A2D34</Color>
    <Color x:Key="MptColorNavigationBackgroundDark">#1B1D22</Color>
    <Color x:Key="MptColorNavigationHoverDark">#262930</Color>
    <Color x:Key="MptColorNavigationSelectedDark">#1E2B45</Color>
    <Color x:Key="MptColorTextPrimaryDark">#F3F4F6</Color>
    <Color x:Key="MptColorTextSecondaryDark">#C3C8D0</Color>
    <Color x:Key="MptColorTextMutedDark">#8B919B</Color>
    <Color x:Key="MptColorWarningBackgroundDark">#3A2C12</Color>
    <Color x:Key="MptColorInfoBackgroundDark">#1E2B45</Color>
    <Color x:Key="MptColorDangerBackgroundDark">#3B1A1C</Color>
    <Color x:Key="MptColorSuccessBackgroundDark">#16301F</Color>

    <SolidColorBrush x:Key="MptBrushAppBackground" Color="{DynamicResource MptColorAppBackgroundLight}" />
    <SolidColorBrush x:Key="MptBrushShellChrome" Color="{DynamicResource MptColorShellChromeLight}" />
    <SolidColorBrush x:Key="MptBrushCardBackground" Color="{DynamicResource MptColorSurfaceLight}" />
    <SolidColorBrush x:Key="MptBrushSurfaceRaised" Color="{DynamicResource MptColorSurfaceRaisedLight}" />
    <SolidColorBrush x:Key="MptBrushSurfaceMuted" Color="{DynamicResource MptColorSurfaceMutedLight}" />
    <SolidColorBrush x:Key="MptBrushSurfaceInset" Color="{DynamicResource MptColorSurfaceInsetLight}" />
    <SolidColorBrush x:Key="MptBrushLayerBackground" Color="{DynamicResource MptColorLayerLight}" />
    <SolidColorBrush x:Key="MptBrushLayerAltBackground" Color="{DynamicResource MptColorLayerAltLight}" />
    <SolidColorBrush x:Key="MptBrushControlFillDefault" Color="{DynamicResource MptColorControlFillLight}" />
    <SolidColorBrush x:Key="MptBrushControlFillHover" Color="{DynamicResource MptColorControlFillHoverLight}" />
    <SolidColorBrush x:Key="MptBrushControlFillPressed" Color="{DynamicResource MptColorControlFillPressedLight}" />
    <SolidColorBrush x:Key="MptBrushBorder" Color="{DynamicResource MptColorBorderLight}" />
    <SolidColorBrush x:Key="MptBrushBorderStrong" Color="{DynamicResource MptColorBorderStrongLight}" />
    <SolidColorBrush x:Key="MptBrushControlStrokeDefault" Color="{DynamicResource MptColorControlStrokeLight}" />
    <SolidColorBrush x:Key="MptBrushDivider" Color="{DynamicResource MptColorDividerLight}" />
    <SolidColorBrush x:Key="MptBrushNavigationBackground" Color="{DynamicResource MptColorNavigationBackgroundLight}" />
    <SolidColorBrush x:Key="MptBrushNavigationHover" Color="{DynamicResource MptColorNavigationHoverLight}" />
    <SolidColorBrush x:Key="MptBrushNavigationSelected" Color="{DynamicResource MptColorNavigationSelectedLight}" />
    <SolidColorBrush x:Key="MptBrushAccent" Color="{DynamicResource MptColorAccent}" />
    <SolidColorBrush x:Key="MptBrushAccentHover" Color="{DynamicResource MptColorAccentHover}" />
    <SolidColorBrush x:Key="MptBrushAccentPressed" Color="{DynamicResource MptColorAccentPressed}" />
    <SolidColorBrush x:Key="MptBrushAccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MptBrushTextPrimary" Color="{DynamicResource MptColorTextPrimaryLight}" />
    <SolidColorBrush x:Key="MptBrushTextSecondary" Color="{DynamicResource MptColorTextSecondaryLight}" />
    <SolidColorBrush x:Key="MptBrushTextMuted" Color="{DynamicResource MptColorTextMutedLight}" />
    <SolidColorBrush x:Key="MptBrushSuccess" Color="{DynamicResource MptColorSuccess}" />
    <SolidColorBrush x:Key="MptBrushWarning" Color="{DynamicResource MptColorWarning}" />
    <SolidColorBrush x:Key="MptBrushWarningBackground" Color="{DynamicResource MptColorWarningBackgroundLight}" />
    <SolidColorBrush x:Key="MptBrushInfoBackground" Color="{DynamicResource MptColorInfoBackgroundLight}" />
    <SolidColorBrush x:Key="MptBrushDangerBackground" Color="{DynamicResource MptColorDangerBackgroundLight}" />
    <SolidColorBrush x:Key="MptBrushSuccessBackground" Color="{DynamicResource MptColorSuccessBackgroundLight}" />
    <SolidColorBrush x:Key="MptBrushDanger" Color="{DynamicResource MptColorDanger}" />
    <SolidColorBrush x:Key="MptBrushInfo" Color="{DynamicResource MptColorInfo}" />
    <SolidColorBrush x:Key="MptBrushScreenEaseAccent" Color="{DynamicResource MptColorScreenEaseAccent}" />
    <SolidColorBrush x:Key="MptBrushScreenEaseAccentHover" Color="{DynamicResource MptColorScreenEaseAccentHover}" />
    <SolidColorBrush x:Key="MptBrushScreenEaseAccentTextMuted" Color="{DynamicResource MptColorScreenEaseAccentTextMuted}" />
    <SolidColorBrush x:Key="MptBrushNeutral" Color="{DynamicResource MptColorTextMutedLight}" />
    <SolidColorBrush x:Key="MptBrushOverlayScrim" Color="#66000000" />
    <SolidColorBrush x:Key="MptBrushTransparent" Color="#00000000" />
    <SolidColorBrush x:Key="MptBrushAccentSoft" Color="#EAF1FE" />
    <SolidColorBrush x:Key="MptBrushNeutralBackground" Color="#F1F3F6" />
    <SolidColorBrush x:Key="MptBrushTintBlueBackground" Color="#EAF1FE" />
    <SolidColorBrush x:Key="MptBrushTintBlueForeground" Color="#2563EB" />
    <SolidColorBrush x:Key="MptBrushTintVioletBackground" Color="#F1EBFE" />
    <SolidColorBrush x:Key="MptBrushTintVioletForeground" Color="#7C3AED" />
    <SolidColorBrush x:Key="MptBrushTintGreenBackground" Color="#E7F6EE" />
    <SolidColorBrush x:Key="MptBrushTintGreenForeground" Color="#059669" />
    <SolidColorBrush x:Key="MptBrushTintAmberBackground" Color="#FEF4E2" />
    <SolidColorBrush x:Key="MptBrushTintAmberForeground" Color="#D97706" />
    <SolidColorBrush x:Key="MptBrushTintCyanBackground" Color="#E4F6FA" />
    <SolidColorBrush x:Key="MptBrushTintCyanForeground" Color="#0891B2" />
    <SolidColorBrush x:Key="MptBrushTintRoseBackground" Color="#FDECEF" />
    <SolidColorBrush x:Key="MptBrushTintRoseForeground" Color="#E11D48" />
    <SolidColorBrush x:Key="MptBrushTintIndigoBackground" Color="#ECEDFD" />
    <SolidColorBrush x:Key="MptBrushTintIndigoForeground" Color="#4F46E5" />
    <SolidColorBrush x:Key="MptBrushTintSlateBackground" Color="#EEF1F5" />
    <SolidColorBrush x:Key="MptBrushTintSlateForeground" Color="#475569" />
    <LinearGradientBrush x:Key="MptBrushBrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#3B82F6" Offset="0" />
      <GradientStop Color="#4F46E5" Offset="1" />
    </LinearGradientBrush>
  </Styles.Resources>
</Styles>
