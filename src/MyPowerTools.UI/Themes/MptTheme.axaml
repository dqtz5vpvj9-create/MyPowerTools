<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="MptBrushAppBackground" Color="#F7F8FB" />
    <SolidColorBrush x:Key="MptBrushCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MptBrushBorder" Color="#DDE2EA" />
    <SolidColorBrush x:Key="MptBrushAccent" Color="#2563EB" />
    <SolidColorBrush x:Key="MptBrushTextPrimary" Color="#374151" />
    <SolidColorBrush x:Key="MptBrushTextSecondary" Color="#586174" />
    <SolidColorBrush x:Key="MptBrushTextMuted" Color="#6B7280" />
    <SolidColorBrush x:Key="MptBrushSuccess" Color="#107C41" />
    <SolidColorBrush x:Key="MptBrushWarning" Color="#9A6700" />
    <SolidColorBrush x:Key="MptBrushDanger" Color="#B42318" />
    <SolidColorBrush x:Key="MptBrushSurfaceInset" Color="#EEF2F7" />

    <Thickness x:Key="MptPagePadding">16,4,16,12</Thickness>
    <Thickness x:Key="MptCardPadding">16</Thickness>
    <Thickness x:Key="MptCompactPadding">10</Thickness>
    <CornerRadius x:Key="MptRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="MptRadiusControl">6</CornerRadius>
    <x:Double x:Key="MptSpacingXs">4</x:Double>
    <x:Double x:Key="MptSpacingS">8</x:Double>
    <x:Double x:Key="MptSpacingM">12</x:Double>
    <x:Double x:Key="MptSpacingL">16</x:Double>
    <x:Double x:Key="MptFontSizeTitle">24</x:Double>
    <x:Double x:Key="MptFontSizeSection">18</x:Double>
    <x:Double x:Key="MptFontSizeMeta">12</x:Double>
  </Styles.Resources>

  <Style Selector="TextBlock.MptPageTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.MptPageSubtitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptSectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.MptMeta">
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeMeta}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextMuted}" />
  </Style>

  <Style Selector="Border.MptCard">
    <Setter Property="Padding" Value="{DynamicResource MptCardPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
  </Style>

  <Style Selector="Border.MptInset">
    <Setter Property="Padding" Value="{DynamicResource MptCompactPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusControl}" />
    <Setter Property="Background" Value="{DynamicResource MptBrushSurfaceInset}" />
  </Style>
</Styles>
