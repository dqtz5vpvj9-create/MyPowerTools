<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <FontFamily x:Key="MptFontFamilyBody">Inter, Segoe UI, system-ui</FontFamily>
    <FontFamily x:Key="MptFontFamilyMono">Cascadia Mono, Consolas, monospace</FontFamily>
    <x:Double x:Key="MptFontSizeTitle">28</x:Double>
    <x:Double x:Key="MptFontSizeSection">18</x:Double>
    <x:Double x:Key="MptFontSizeCardTitle">16</x:Double>
    <x:Double x:Key="MptFontSizeBody">14</x:Double>
    <x:Double x:Key="MptFontSizeCaption">12</x:Double>
    <x:Double x:Key="MptFontSizeMeta">12</x:Double>
    <x:Double x:Key="MptLineHeightTitle">36</x:Double>
    <x:Double x:Key="MptLineHeightSection">28</x:Double>
    <x:Double x:Key="MptLineHeightCardTitle">24</x:Double>
    <x:Double x:Key="MptLineHeightBody">22</x:Double>
    <x:Double x:Key="MptLineHeightCaption">18</x:Double>
  </Styles.Resources>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MptFontFamilyBody}" />
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeBody}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightBody}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.MptPageTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeTitle}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.MptPageSubtitle">
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeBody}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightBody}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptSectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeSection}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.MptCardTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeCardTitle}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightCardTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.MptBody">
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeBody}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightBody}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMeta">
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeCaption}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextMuted}" />
  </Style>

  <Style Selector="TextBlock.MptMono">
    <Setter Property="FontFamily" Value="{DynamicResource MptFontFamilyMono}" />
    <Setter Property="FontSize" Value="{DynamicResource MptFontSizeCaption}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptLineHeightCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
  </Style>
</Styles>
