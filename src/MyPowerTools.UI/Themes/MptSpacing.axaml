<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Thickness x:Key="MptPagePadding">16,4,16,12</Thickness>
    <Thickness x:Key="MptCardPadding">16</Thickness>
    <Thickness x:Key="MptCompactPadding">10</Thickness>
    <Thickness x:Key="MptListItemPadding">10,8</Thickness>
    <Thickness x:Key="MptActionBarPadding">0,4,0,0</Thickness>
    <Thickness x:Key="MptGapBottomXs">0,0,0,4</Thickness>
    <Thickness x:Key="MptGapBottomS">0,0,0,6</Thickness>
    <Thickness x:Key="MptGapBottomM">0,0,0,8</Thickness>
    <Thickness x:Key="MptGapBottomL">0,0,0,12</Thickness>
    <Thickness x:Key="MptGapBottomXl">0,0,0,18</Thickness>
    <Thickness x:Key="MptGapRightM">0,0,8,0</Thickness>
    <Thickness x:Key="MptWrapItemMargin">0,0,8,8</Thickness>
    <Thickness x:Key="MptFormRowMargin">0,0,0,4</Thickness>
    <Thickness x:Key="MptCommandPanelMargin">12,0,0,0</Thickness>
    <Thickness x:Key="MptSearchPanelMargin">0,4,16,12</Thickness>
    <Thickness x:Key="MptStatusBarMargin">16,0,16,8</Thickness>
    <Thickness x:Key="MptSearchBoxPadding">14</Thickness>
    <Thickness x:Key="MptAuditTitleMargin">0,8,0,2</Thickness>
    <CornerRadius x:Key="MptRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="MptRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="MptRadiusBadge">999</CornerRadius>
    <x:Double x:Key="MptSpacingXs">4</x:Double>
    <x:Double x:Key="MptSpacingS">8</x:Double>
    <x:Double x:Key="MptSpacingM">12</x:Double>
    <x:Double x:Key="MptSpacingL">16</x:Double>
    <x:Double x:Key="MptSpacingXl">24</x:Double>
  </Styles.Resources>
</Styles>
