<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <x:Double x:Key="MptSpacingXs">4</x:Double>
    <x:Double x:Key="MptSpacingS">8</x:Double>
    <x:Double x:Key="MptSpacingM">12</x:Double>
    <x:Double x:Key="MptSpacingL">16</x:Double>
    <x:Double x:Key="MptSpacingXl">20</x:Double>
    <x:Double x:Key="MptSpacing2Xl">24</x:Double>
    <x:Double x:Key="MptSpacing3Xl">32</x:Double>
    <x:Double x:Key="MptSpacing4Xl">40</x:Double>
    <Thickness x:Key="MptPagePadding">28</Thickness>
    <Thickness x:Key="MptCardPadding">16</Thickness>
    <Thickness x:Key="MptCompactPadding">12</Thickness>
    <Thickness x:Key="MptListItemPadding">12,8</Thickness>
    <Thickness x:Key="MptActionBarPadding">0,8,0,0</Thickness>
    <Thickness x:Key="MptGapBottomXs">0,0,0,4</Thickness>
    <Thickness x:Key="MptGapBottomS">0,0,0,8</Thickness>
    <Thickness x:Key="MptGapBottomM">0,0,0,8</Thickness>
    <Thickness x:Key="MptGapBottomL">0,0,0,16</Thickness>
    <Thickness x:Key="MptGapBottomXl">0,0,0,24</Thickness>
    <Thickness x:Key="MptGapTopM">0,8,0,0</Thickness>
    <Thickness x:Key="MptGapRightM">0,0,8,0</Thickness>
    <Thickness x:Key="MptWrapItemMargin">0,0,8,8</Thickness>
    <Thickness x:Key="MptFormRowMargin">0,0,0,8</Thickness>
    <Thickness x:Key="MptCommandPanelMargin">12,0,0,0</Thickness>
    <Thickness x:Key="MptSearchPanelMargin">0,4,16,12</Thickness>
    <Thickness x:Key="MptStatusBarMargin">28,0,28,8</Thickness>
    <Thickness x:Key="MptSearchBoxPadding">16,8</Thickness>
    <Thickness x:Key="MptAuditTitleMargin">0,8,0,2</Thickness>
    <Thickness x:Key="MptOverlayPadding">24</Thickness>
    <Thickness x:Key="MptOverlayPanelPadding">24</Thickness>
    <Thickness x:Key="MptSidebarPadding">16</Thickness>
    <Thickness x:Key="MptTopBarPadding">16,10</Thickness>
    <Thickness x:Key="MptButtonPadding">14,7</Thickness>
    <Thickness x:Key="MptInputPadding">12,8</Thickness>
    <Thickness x:Key="MptCompactBadgePadding">8,2</Thickness>
    <Thickness x:Key="MptBorderThickness">1</Thickness>
  </Styles.Resources>
</Styles>
