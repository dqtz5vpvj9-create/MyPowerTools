    <IsPackable>true</IsPackable>
    <PackageId>MyPowerTools.UI</PackageId>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
