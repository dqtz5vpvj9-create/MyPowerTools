<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    MPT mobile typography (M1).

    Every selector is an explicit MptMobile* class, so adding this file to Application.Styles
    cannot change desktop UI: desktop never uses these class names. Sizes come from the
    MptMobileFontSize*/LineHeight* tokens, so a host that applies a font scale only has to
    override those tokens once.

    Line heights are set generously on wrapping text and no rule pins a text container to a
    fixed Height, so enlarged system fonts reflow instead of clipping.
  -->
  <Styles.Resources>
    <FontFamily x:Key="MptMobileFontFamilyMono">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Roboto Mono, monospace</FontFamily>
  </Styles.Resources>

  <Style Selector="TextBlock.MptMobilePageTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizePageTitle}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightPageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobilePageSubtitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizePageSubtitle}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightPageSubtitle}" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileSectionTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeSectionTitle}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightSectionTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileHeroTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeHeroTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileCardTitle">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileBody, SelectableTextBlock.MptMobileBody">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeBody}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightBody}" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileCaption, SelectableTextBlock.MptMobileCaption">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeCaption}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileMeta, SelectableTextBlock.MptMobileMeta">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeMeta}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightMeta}" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileMicro">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeMicro}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightMicro}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource MptMobileLetterSpacingMicro}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileRowTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeBody}" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileRowSubtitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeCaption}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <Style Selector="TextBlock.MptMobileRowMeta">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeMeta}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightMeta}" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileNote, SelectableTextBlock.MptMobileNote">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeCaption}" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileMono, SelectableTextBlock.MptMobileMono">
    <Setter Property="FontFamily" Value="{DynamicResource MptMobileFontFamilyMono}" />
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeMeta}" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileCommandTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileTileTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileTileDescription">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeMeta}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightMeta}" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,5,0,0" />
  </Style>

  <Style Selector="TextBlock.MptMobileAvatarText">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileAvatarTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.MptMobileDetailValue">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeDetailValue}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileEmptyTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeEmptyTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,25,0,10" />
  </Style>

  <Style Selector="TextBlock.MptMobileSheetTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeSheetTitle}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightSheetTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileSuccessTitle">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style Selector="TextBlock.MptMobileOnboardingTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizePageTitle}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightPageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,19,0,0" />
  </Style>

  <Style Selector="TextBlock.MptMobileOnboardingDescription">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizePageSubtitle}" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,13,0,24" />
  </Style>

  <Style Selector="TextBlock.MptMobileConnectionCode">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeConnectionCode}" />
    <Setter Property="LetterSpacing" Value="{DynamicResource MptMobileLetterSpacingConnectionCode}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileFieldLabel">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeCaption}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,15,0,7" />
  </Style>

  <Style Selector="TextBlock.MptMobileCategoryTitle">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeMeta}" />
    <Setter Property="LetterSpacing" Value="0.4" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,22,0,10" />
  </Style>

  <Style Selector="TextBlock.MptMobileTabLabel">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeMicro}" />
    <Setter Property="LineHeight" Value="{DynamicResource MptMobileLineHeightMicro}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileReceiptValue">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeCaption}" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileHello">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,5,0,0" />
  </Style>

  <Style Selector="TextBlock.MptMobileAccentText">
    <Setter Property="Foreground" Value="{DynamicResource MptMobileAccentBrush}" />
  </Style>

  <Style Selector="TextBlock.MptMobileSuccessText">
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSuccessBrush}" />
  </Style>

  <Style Selector="TextBlock.MptMobileWarningText">
    <Setter Property="Foreground" Value="{DynamicResource MptMobileWarningBrush}" />
  </Style>

  <Style Selector="TextBlock.MptMobileOfflineHint">
    <Setter Property="FontSize" Value="{DynamicResource MptMobileFontSizeMeta}" />
    <Setter Property="Foreground" Value="{DynamicResource MptMobileOfflineHintBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.MptMobileFadedText">
    <Setter Property="Foreground" Value="{DynamicResource MptMobileSecondaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.MptMobileFavoriteText">
    <Setter Property="Foreground" Value="{DynamicResource MptMobileAccentBrush}" />
  </Style>

  <!--
    Root contract: every mobile page root carries MptMobileRoot. It supplies the page
    background plus the inherited text colour and base size, so pages do not restate them and
    a single class on the root is enough to switch a page into the mobile visual language.

    Container selectors use ":is(...)" on purpose: a plain Avalonia type selector matches the
    exact type only (Grid/StackPanel/DockPanel would all miss "Panel.MptMobilePage"), while
    ":is(Panel)" also covers every derived panel type. x:SetterTargetType tells the XAML
    compiler which type resolves the setter when the selector is an interface-like match.
  -->
  <Style Selector=":is(Control).MptMobileRoot" x:SetterTargetType="Control">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource MptMobileTextBrush}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource MptMobileFontSizeBody}" />
  </Style>

  <Style Selector="Border.MptMobileRoot">
    <Setter Property="Background" Value="{DynamicResource MptMobileBackgroundBrush}" />
  </Style>

  <Style Selector=":is(Panel).MptMobileRoot" x:SetterTargetType="Panel">
    <Setter Property="Background" Value="{DynamicResource MptMobileBackgroundBrush}" />
  </Style>

  <Style Selector=":is(ContentControl).MptMobileRoot" x:SetterTargetType="ContentControl">
    <Setter Property="Background" Value="{DynamicResource MptMobileBackgroundBrush}" />
  </Style>

  <!-- Page scaffolding: page paddings, section headers and the trailing scroll spacer. -->
  <Style Selector=":is(Panel).MptMobilePage" x:SetterTargetType="Panel">
    <Setter Property="Margin" Value="{DynamicResource MptMobilePagePadding}" />
  </Style>

  <Style Selector="Border.MptMobilePage">
    <Setter Property="Padding" Value="{DynamicResource MptMobilePagePadding}" />
  </Style>

  <Style Selector=":is(ContentControl).MptMobilePage" x:SetterTargetType="ContentControl">
    <Setter Property="Padding" Value="{DynamicResource MptMobilePagePadding}" />
  </Style>

  <Style Selector=":is(Panel).MptMobilePageNarrow" x:SetterTargetType="Panel">
    <Setter Property="Margin" Value="{DynamicResource MptMobilePagePaddingNarrow}" />
  </Style>

  <Style Selector="Border.MptMobilePageNarrow">
    <Setter Property="Padding" Value="{DynamicResource MptMobilePagePaddingNarrow}" />
  </Style>

  <Style Selector=":is(ContentControl).MptMobilePageNarrow" x:SetterTargetType="ContentControl">
    <Setter Property="Padding" Value="{DynamicResource MptMobilePagePaddingNarrow}" />
  </Style>

  <Style Selector=":is(Panel).MptMobileSectionHeader" x:SetterTargetType="Panel">
    <Setter Property="Margin" Value="{DynamicResource MptMobileSectionHeaderMargin}" />
  </Style>

  <Style Selector="Border.MptMobileSectionHeader">
    <Setter Property="Margin" Value="{DynamicResource MptMobileSectionHeaderMargin}" />
  </Style>

  <Style Selector=":is(Panel).MptMobilePageHeader" x:SetterTargetType="Panel">
    <Setter Property="Margin" Value="{DynamicResource MptMobilePageHeaderMargin}" />
  </Style>

  <Style Selector="Border.MptMobilePageHeader">
    <Setter Property="Margin" Value="{DynamicResource MptMobilePageHeaderMargin}" />
  </Style>

  <Style Selector=":is(Panel).MptMobileBottomSpace" x:SetterTargetType="Panel">
    <Setter Property="Margin" Value="{DynamicResource MptMobileBottomSpaceMargin}" />
  </Style>

  <Style Selector="Border.MptMobileBottomSpace">
    <Setter Property="Margin" Value="{DynamicResource MptMobileBottomSpaceMargin}" />
  </Style>
</Styles>
