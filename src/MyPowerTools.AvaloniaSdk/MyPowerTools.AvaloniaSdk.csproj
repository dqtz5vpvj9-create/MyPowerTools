<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>MyPowerTools.AvaloniaSdk</PackageId>
    <Version>0.3.0</Version>
    <Authors>MyPowerTools</Authors>
    <Description>Stable Avalonia surface host contracts, command and navigation bridge, and theme resources for MyPowerTools.</Description>
    <PackageTags>mypowertools avalonia sdk surface</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <!--
      MptQrCode renders connection codes. ZXing.Net is the same pure managed encoder/decoder the
      Android pairing scanner already uses, so the app keeps one QR implementation in its graph
      instead of a second one, and a consumer that also references the scanner unifies to this
      exact version. It ships no native assets, no network access and no image service: the
      control rasterises the module matrix itself.
    -->
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyPowerTools.Abstractions\MyPowerTools.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Themes\MptSdkTheme.axaml" />
    <AvaloniaResource Include="Themes\MptMobileTheme.axaml" />
    <AvaloniaResource Include="Themes\MptMobileTokens.axaml" />
    <AvaloniaResource Include="Themes\MptMobileTypography.axaml" />
    <AvaloniaResource Include="Themes\MptMobileSurfaces.axaml" />
    <AvaloniaResource Include="Themes\MptMobileControls.axaml" />
    <AvaloniaResource Include="Themes\MptMobileIcons.axaml" />
    <None Include="..\..\docs\sdk\dotnet-surface.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
