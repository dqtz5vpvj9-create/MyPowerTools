<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>MyPowerTools.AvaloniaSdk</PackageId>
    <Version>0.2.1</Version>
    <Authors>MyPowerTools</Authors>
    <Description>Stable Avalonia surface host contracts, command and navigation bridge, and theme resources for MyPowerTools.</Description>
    <PackageTags>mypowertools avalonia sdk surface</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MyPowerTools.Abstractions\MyPowerTools.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Themes\MptSdkTheme.axaml" />
    <AvaloniaResource Include="Themes\MptMobileTheme.axaml" />
    <AvaloniaResource Include="Themes\MptMobileTokens.axaml" />
    <AvaloniaResource Include="Themes\MptMobileTypography.axaml" />
    <AvaloniaResource Include="Themes\MptMobileSurfaces.axaml" />
    <AvaloniaResource Include="Themes\MptMobileControls.axaml" />
    <AvaloniaResource Include="Themes\MptMobileIcons.axaml" />
    <None Include="..\..\docs\sdk\dotnet-surface.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
