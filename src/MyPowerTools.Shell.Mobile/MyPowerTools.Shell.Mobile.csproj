<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Same Shell contract/resources, a separate build graph without desktop renderers. -->
    <AssemblyName>MyPowerTools.Shell.Avalonia</AssemblyName>
    <RootNamespace>MyPowerTools.Shell.Avalonia</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyPowerTools.Abstractions\MyPowerTools.Abstractions.csproj" />
    <ProjectReference Include="..\MyPowerTools.Runtime\MyPowerTools.Runtime.csproj" />
    <ProjectReference Include="..\MyPowerTools.Protocol\MyPowerTools.Protocol.csproj" />
    <ProjectReference Include="..\MyPowerTools.Broker\MyPowerTools.Broker.csproj" />
    <ProjectReference Include="..\MyPowerTools.Platform\MyPowerTools.Platform.csproj" />
    <ProjectReference Include="..\MyPowerTools.Platform.Windows\MyPowerTools.Platform.Windows.csproj" />
    <ProjectReference Include="..\MyPowerTools.HostControl.Client\MyPowerTools.HostControl.Client.csproj" />
    <ProjectReference Include="..\MyPowerTools.ServiceManager.Client\MyPowerTools.ServiceManager.Client.csproj" />
    <ProjectReference Include="..\MyPowerTools.Ipc.Shared\MyPowerTools.Ipc.Shared.csproj" />
    <ProjectReference Include="..\MyPowerTools.UI\MyPowerTools.UI.csproj" />
    <ProjectReference Include="..\MyPowerTools.AvaloniaSdk\MyPowerTools.AvaloniaSdk.csproj" />
    <ProjectReference Include="..\MyPowerTools.WebSurface.Avalonia\MyPowerTools.WebSurface.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\MyPowerTools.ico"
                      Link="Assets\MyPowerTools.ico" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../MyPowerTools.Shell.Avalonia/**/*.cs"
             Exclude="../MyPowerTools.Shell.Avalonia/Program.cs;../MyPowerTools.Shell.Avalonia/bin/**;../MyPowerTools.Shell.Avalonia/obj/**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <AvaloniaResource Include="../MyPowerTools.Shell.Avalonia/**/*.axaml"
                      Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
