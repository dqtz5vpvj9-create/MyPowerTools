<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>MyPowerTools.Protocol</PackageId>
    <Version>0.2.0</Version>
    <Authors>MyPowerTools</Authors>
    <Description>Generated gRPC and IPC contracts for MyPowerTools hosts and external runtimes.</Description>
    <PackageTags>mypowertools grpc ipc protocol</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.81.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\mpt_module_v1.proto" GrpcServices="Both" ProtoRoot="..\..\proto" />
    <Protobuf Include="..\..\proto\mpt_host_control_v1.proto" GrpcServices="Both" ProtoRoot="..\..\proto" />
    <Protobuf Include="..\..\proto\mpt_service_manager_v1.proto" GrpcServices="Both" ProtoRoot="..\..\proto" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\proto\*.proto" Pack="true" PackagePath="proto\" />
    <None Include="..\..\sdk\protocol\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>

