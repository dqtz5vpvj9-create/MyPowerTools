<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MyPowerTools.WebToolHost</AssemblyName>
    <RootNamespace>MyPowerTools.WebToolHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../MyPowerTools.WebSurface.Shared/ShortcutForwarding.inc" LogicalName="MptShortcutForwarding" />
    <Compile Include="../MyPowerTools.AvaloniaSdk/CloudAuthorization.cs" Link="CloudAuthorization.cs" />
  </ItemGroup>
</Project>
