<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Android provider project targets net10.0-android, so the Android-free rule files are
         linked into this assembly. This keeps the lifecycle, naming and messaging rules testable
         on a build machine without a device or emulator. -->
    <Compile Include="../../ForegroundActivityCoordinator.cs" Link="ForegroundActivityCoordinator.cs" />
    <Compile Include="../../DownloadPublication.cs" Link="DownloadPublication.cs" />
    <Compile Include="../../AndroidUnsupportedServices.cs" Link="AndroidUnsupportedServices.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../MyPowerTools.Platform.Abstractions/MyPowerTools.Platform.Abstractions.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
