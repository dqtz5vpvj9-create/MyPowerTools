<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>zh_CN</string>
  <key>CFBundleDisplayName</key>
  <string>MyPowerTools Service Manager</string>
  <key>CFBundleExecutable</key>
  <string>MyPowerTools.ServiceManager</string>
  <key>CFBundleIdentifier</key>
  <string>com.mypowertools.servicemanager</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>MyPowerTools Service Manager</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <!-- scripts/publish-macos.ps1 stamps the two version keys below from version.json. -->
  <key>CFBundleShortVersionString</key>
  <string>0.2.0</string>
  <key>CFBundleVersion</key>
  <string>200</string>
  <key>CFBundleIconFile</key>
  <string>MyPowerTools</string>
  <!-- The ServiceManager is a pure launchd/IPC supervisor: it never links AppKit and never
       publishes notifications, so it is background-only. -->
  <key>LSBackgroundOnly</key>
  <true/>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
